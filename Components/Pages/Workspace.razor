                    Time = point.Time,
                    X = point.X,
                    Y = point.Y,
                    Vx = point.HorizontalVelocity,
                    Vy = point.VerticalVelocity,
                    Speed = point.Speed
                }).ToArray();

            var safeName = MakeSafeFileName(simulationName);

            await JS.InvokeVoidAsync(
                "pssDownloadCompleteSimulationPdf",
                $"{safeName}.pdf",
                metadata,
                graphImages,
                rows,
                savedNotesTitle ?? string.Empty,
                savedNotesContent ?? string.Empty);
