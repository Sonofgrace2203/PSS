    private async Task ExportAllGraphsPngAsync()
    {
        if (trajectory.Count == 0 || isExportingCsv || isExportingNotes || isExportingGraphs || isExportingPdf ||
isExportingDocx)
            return;

        isExportingGraphs = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Capture graphs without changing the selected tab.
            await InvokeAsync(StateHasChanged);
            await Task.Delay(700);

            var graphs = new[]
            {
            new { Title = "Position vs Time", Chart = positionGraph },
            new { Title = "Velocity vs Time", Chart = velocityGraph },
            new { Title = "Energy vs Time", Chart = energyGraph },
            new { Title = "Displacement vs Time", Chart = displacementGraph }
        };

            var graphImages = new List<GraphPngExport>();

            foreach (var graph in graphs)
            {
                if (graph.Chart is null)
                    throw new InvalidOperationException(
                        $"{graph.Title} chart is not ready.");

                var imageData = await graph.Chart.GetPngDataUriAsync();

                if (string.IsNullOrWhiteSpace(imageData))
                    throw new InvalidOperationException(
                        $"Could not capture the {graph.Title} graph.");

                graphImages.Add(new GraphPngExport
                {
                    Title = graph.Title,
                    DataUri = imageData
                });
            }

            var metadata = new PngExportMetadata
            {
                SimulationName = simulationName ?? string.Empty,
                ExportedAt = DateTime.Now.ToString(
                    "yyyy-MM-dd HH:mm:ss",
                    CultureInfo.InvariantCulture),
                InitialVelocity = initialVelocity,
                LaunchAngle = launchAngle,
                Gravity = gravity,
                InitialHeight = initialHeight,
                TimeStep = timeStep,
                Range = rangeResult,
                MaximumHeight = maximumHeightResult,
                TimeOfFlight = timeOfFlightResult,
                FinalSpeed = finalSpeedResult,
                TrajectoryPoints = trajectory.Count
            };

            var projectFileName = MakeSafeFileName(simulationName);

            await JS.InvokeVoidAsync(
                "pssDownloadCombinedGraphsPng",
                $"{projectFileName}.png",
                graphImages,
                metadata);
        }
        catch (Exception ex)
        {
            pngExportError = $"PNG export failed: {ex.Message}";
            consoleLines.Add(pngExportError);
        }
        finally
        {
            isExportingGraphs = false;
            await InvokeAsync(StateHasChanged);
        }
    }


    private static string MakeSafeFileName(string? title)
    {
        if (string.IsNullOrWhiteSpace(title))
            title = "Untitled Simulation";

        foreach (char invalidChar in Path.GetInvalidFileNameChars())
        {
            title = title.Replace(invalidChar, '-');
        }

        return title.Trim().TrimEnd('.');
    }

    
