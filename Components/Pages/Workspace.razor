    private async Task LoadDeleteConfirmationSettingAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<GeneralSettingsResponse>(
                "/api/settings/general/");

            if (settings is not null)
            {
                confirmBeforeDeleting = settings.ConfirmBeforeDeleting;
            }
        }
        catch (HttpRequestException)
        {
            // Keep confirmation enabled if the setting cannot be loaded.
        }
        catch (JsonException)
        {
            // Keep confirmation enabled if the response cannot be read.
        }
    }


    private async Task LoadSimulationSettingsAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<SimulationSettingsResponse>(
                "/api/settings/simulation/");

            if (settings is null)
                return;

            defaultGravity = settings.Gravity;
            defaultTimeStep = settings.DefaultTimeStep;
            maximumSimulationTime = settings.MaximumSimulationTime;
            maximumDataPoints = settings.MaximumDataPoints;

            // Apply saved defaults only when the workspace has no
            // simulation loaded from history.
            if (!isLoadedFromHistory && !hasSimulationStarted)
            {
                gravity = defaultGravity;
                timeStep = defaultTimeStep;
            }
        }
        catch (HttpRequestException)
        {
            // Keep the existing defaults if the API is unavailable.
        }
        catch (JsonException)
        {
            // Keep the existing defaults if the response cannot be read.
        }
    }



    protected override async Task OnParametersSetAsync()
    {
        if (SimulationIdFromQuery is not Guid id)
            return;

        if (loadedSimulationId == id)
            return;

        await LoadSavedSimulationAsync(id);
    }

    private async Task LoadSavedSimulationAsync(Guid id)
    {
        PausePlayback();

        isRunning = true;
        errorMessage = null;
        successMessage = null;
        notesStatus = null;
        notesSaved = false;

        trajectory.Clear();
        consoleLines.Clear();
        currentPointIndex = 0;
        tablePage = 1;
        tableSearch = "";

        try
        {
            var saved = await Http.GetFromJsonAsync<SavedSimulationDetails>(
                $"/api/simulations/projectile/history/{id}");

            if (saved is null || saved.SimulationId != id)
            {
                errorMessage = "The saved simulation could not be found.";
                return;
            }

            // Restore the saved parameters.
            simulationName = saved.Name;
            moduleId = saved.ModuleId;
            initialVelocity = saved.InitialVelocity;
            launchAngle = saved.LaunchAngle;
            gravity = saved.Gravity;
            initialHeight = saved.InitialHeight;
            timeStep = saved.TimeStep;

            // Restore the original stored summary results.
            rangeResult = saved.Range;
            maximumHeightResult = saved.MaximumHeight;
            timeOfFlightResult = saved.TimeOfFlight;
            finalSpeedResult = saved.FinalSpeed;

            // Restore the saved record ID and its notes.
            currentSimulationId = saved.SimulationId;
            isLoadedFromHistory = true;

            savedNotesTitle = saved.NotesTitle ?? "";
            savedNotesContent = saved.SimulationNotes ?? "";

            notesTitle = "";
            simulationNotes = "";
            isEditingSavedNotes = false;

            // Keep the controls in the same locked state as a completed run.
            hasSimulationStarted = true;
            runSimulation = true;
            IsSimulation();

            consoleLines.Add(
                $"[{DateTime.Now:HH:mm:ss}] Loading saved projectile simulation.");
            consoleLines.Add($"Simulation ID: {saved.SimulationId}");
            consoleLines.Add($"Original saved date (UTC): {saved.CreatedAtUtc:O}");

            // Recalculate the trajectory without creating another history record.
            var request = new
            {
                initialVelocity = saved.InitialVelocity,
                launchAngle = saved.LaunchAngle,
                gravity = saved.Gravity,
                initialHeight = saved.InitialHeight,
                timeStep = saved.TimeStep
            };

            using var response = await Http.PostAsJsonAsync(
                "/api/simulations/projectile/trajectory",
                request);

            if (!response.IsSuccessStatusCode)
            {
                errorMessage =
                    $"The saved summary loaded, but trajectory calculation failed " +
                    $"({(int)response.StatusCode}).";

                consoleLines.Add(errorMessage);
                return;
            }

            using var document = JsonDocument.Parse(
                await response.Content.ReadAsStringAsync());

            var result = document.RootElement;

            if (result.TryGetProperty("trajectory", out var points)
                && points.ValueKind == JsonValueKind.Array)
            {
                foreach (var point in points.EnumerateArray())
                {
                    trajectory.Add(new ProjectileTrajectoryPoint
                    {
                        Time = ReadNumber(point, "time"),
                        X = ReadNumber(point, "x"),
                        Y = ReadNumber(point, "y"),
                        HorizontalVelocity =
                            ReadNumber(point, "horizontalVelocity"),
                        VerticalVelocity =
                            ReadNumber(point, "verticalVelocity"),
                        Speed = ReadNumber(point, "speed")
                    });
                }
            }

            if (trajectory.Count == 0)
            {
                errorMessage =
                    "The saved summary loaded, but no trajectory points were returned.";
                consoleLines.Add(errorMessage);
                return;
            }

            consoleLines.Add($"Range: {rangeResult:F2} m");
            consoleLines.Add($"Maximum height: {maximumHeightResult:F2} m");
            consoleLines.Add($"Time of flight: {timeOfFlightResult:F2} s");
            consoleLines.Add($"Final speed: {finalSpeedResult:F2} m/s");
            consoleLines.Add($"Trajectory points restored: {trajectory.Count}");

            currentPointIndex = 0;
            loadedSimulationId = id;

            successMessage = "Saved simulation loaded successfully.";
            consoleLines.Add("Ready to inspect, replay, and export this simulation.");

            // Start the animation using the restored trajectory.
            PlayPlayback();
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not connect to the PSS backend while loading this simulation.";
            consoleLines.Add($"ERROR: {errorMessage}");
        }
        catch (JsonException)
        {
            errorMessage =
                "The saved simulation response could not be read.";
            consoleLines.Add($"ERROR: {errorMessage}");
        }
        finally
        {
            isRunning = false;
        }
    }


    private string? ValidateSimulationParameters()
    {
        if (!double.IsFinite(initialVelocity) || initialVelocity <= 0)
            return "Initial velocity must be a finite value greater than zero.";

        if (!double.IsFinite(launchAngle) ||
            launchAngle < 0 || launchAngle > 90)
            return "Launch angle must be between 0 and 90 degrees.";

        if (!double.IsFinite(gravity) || gravity <= 0)
            return "Gravity must be a finite value greater than zero.";

        if (!double.IsFinite(initialHeight) || initialHeight < 0)
            return "Initial height must be a finite value greater than or equal to zero.";

        if (!double.IsFinite(timeStep) || timeStep <= 0)
            return "Time step must be a finite value greater than zero.";

        var angleRadians = launchAngle * Math.PI / 180.0;
        var verticalVelocity = initialVelocity * Math.Sin(angleRadians);

        var discriminant =
            verticalVelocity * verticalVelocity +
            2 * gravity * initialHeight;

        if (!double.IsFinite(discriminant) || discriminant < 0)
            return "The selected parameters produce an invalid trajectory.";

        var timeOfFlight =
            (verticalVelocity + Math.Sqrt(discriminant)) / gravity;

        if (!double.IsFinite(timeOfFlight) || timeOfFlight < 0)
            return "The calculated flight time is invalid.";

        if (timeOfFlight > maximumSimulationTime)
        {
            return $"Flight time ({timeOfFlight:F2} s) exceeds the configured " +
                   $"maximum simulation time ({maximumSimulationTime:F2} s).";
        }

        var requiredSteps = Math.Ceiling(timeOfFlight / timeStep);

        if (!double.IsFinite(requiredSteps) ||
            requiredSteps + 1 > maximumDataPoints)
        {
            return $"This simulation would exceed the configured maximum of " +
                   $"{maximumDataPoints:N0} trajectory points. Increase the time step.";
        }

        return null;
    }


    private async Task RunSimulation()
    {
        
        if (parametersLocked)
            return;

        if (string.IsNullOrWhiteSpace(simulationName))
        {
            errorMessage = "Please enter a simulation name before running.";
            successMessage = null;
            return;
        }

        var validationError = ValidateSimulationParameters();

        if (validationError is not null)
        {
            errorMessage = validationError;
            successMessage = null;
            return;
        }

        simulationName = simulationName.Trim();

        PausePlayback();

        hasSimulationStarted = true;
        isRunning = true;
        runSimulation = true;
        errorMessage = null;
        successMessage = null;
        currentSimulationId = null;
        isLoadedFromHistory = false;

        trajectory.Clear();
        consoleLines.Clear();
        currentPointIndex = 0;

        consoleLines.Add($"[{DateTime.Now:HH:mm:ss}] Starting projectile simulation.");
        consoleLines.Add($"Initial velocity: {initialVelocity:F2} m/s");
        consoleLines.Add($"Launch angle: {launchAngle:F2} degrees");
        consoleLines.Add($"Gravity: {gravity:F2} m/s²");

        try
        {
            
            var request = new RunProjectileSimulationRequest
            {
                Name = string.IsNullOrWhiteSpace(simulationName)
                    ? "Projectile Motion"
                    : simulationName.Trim(),

                ModuleId = moduleId,

                InitialVelocity = initialVelocity,
                LaunchAngle = launchAngle,
                Gravity = gravity,
                InitialHeight = initialHeight,
                TimeStep = timeStep
            };

            using var response = await Http.PostAsJsonAsync(
                "/api/simulations/projectile/run",
                request);

            if (!response.IsSuccessStatusCode)
            {
                var details = await response.Content.ReadAsStringAsync();

                errorMessage =
                    $"Simulation failed ({(int)response.StatusCode}). {details}";

                consoleLines.Add($"ERROR: {errorMessage}");
                return;
            }

            using var document = JsonDocument.Parse(
                await response.Content.ReadAsStringAsync());

            var result = document.RootElement;

            // Capture the database ID returned by the backend.
            // A null ID is expected when Auto Save Results is disabled.
            if (result.TryGetProperty("simulationId", out var idElement)
                && idElement.ValueKind == JsonValueKind.String
                && Guid.TryParse(idElement.GetString(), out var simulationId))
            {
                currentSimulationId = simulationId;
                consoleLines.Add("Simulation saved to History.");
            }
            else
            {
                currentSimulationId = null;
                consoleLines.Add(
                    "Auto Save Results is off, or no saved simulation ID was returned. " +
                    "The results can still be viewed and exported.");
            }

            rangeResult = ReadNumber(result, "range");
            maximumHeightResult = ReadNumber(result, "maximumHeight");
            timeOfFlightResult = ReadNumber(result, "timeOfFlight");
            finalSpeedResult = ReadNumber(result, "finalSpeed");

            if (result.TryGetProperty("trajectory", out var points)
                && points.ValueKind == JsonValueKind.Array)
            {
                foreach (var point in points.EnumerateArray())
                {
                    trajectory.Add(new ProjectileTrajectoryPoint
                    {
                        Time = ReadNumber(point, "time"),
                        X = ReadNumber(point, "x"),
                        Y = ReadNumber(point, "y"),
                        HorizontalVelocity = ReadNumber(point, "horizontalVelocity"),
                        VerticalVelocity = ReadNumber(point, "verticalVelocity"),
                        Speed = ReadNumber(point, "speed")
                    });
                }
            }

            consoleLines.Add($"Range: {rangeResult:F2} m");
            consoleLines.Add($"Maximum height: {maximumHeightResult:F2} m");
            consoleLines.Add($"Time of flight: {timeOfFlightResult:F2} s");
            consoleLines.Add($"Final speed: {finalSpeedResult:F2} m/s");
            consoleLines.Add($"Trajectory points received: {trajectory.Count}");

            if (trajectory.Count == 0)
            {
                errorMessage = "The simulation completed, but no trajectory points were returned.";
                consoleLines.Add($"ERROR: {errorMessage}");
                return;
            }

            successMessage = null;
            consoleLines.Add("Simulation results loaded. Playback started.");

            currentPointIndex = 0;
            PlayPlayback();
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the PSS backend. Check that the API is running on port 5004.";
            consoleLines.Add($"ERROR: {errorMessage}");
        }
        catch (JsonException)
        {
            errorMessage = "The backend response could not be read. Please check the API response format.";
            consoleLines.Add($"ERROR: {errorMessage}");
        }
        finally
        {
            isRunning = false;
        }
    }

    private void ResetSimulation()
    {
        PausePlayback();

        hasSimulationStarted = false;
        isRunning = false;

        initialVelocity = 30;
        launchAngle = 45;
        gravity = defaultGravity;
        initialHeight = 0;
        timeStep = defaultTimeStep;

        showMoreOptions = false;
        runSimulation = false;

        rangeResult = 0;
        maximumHeightResult = 0;
        timeOfFlightResult = 0;
        finalSpeedResult = 0;

        trajectory.Clear();
        consoleLines.Clear();
        currentPointIndex = 0;

        // Reset notes for a fresh simulation.
        ClearNotes();

        savedNotesTitle = "";
        savedNotesContent = "";

        showDeleteNotesDialog = false;

        // Prevent notes from being associated with the previous simulation.
        currentSimulationId = null;

        errorMessage = null;
        successMessage = null;
    }

    private static double ReadNumber(
        JsonElement result,
        params string[] propertyNames)
    {
        if (result.ValueKind != JsonValueKind.Object)
            return 0;

        foreach (var property in result.EnumerateObject())
        {
            foreach (var name in propertyNames)
            {
                if (string.Equals(
                        property.Name,
                        name,
                        StringComparison.OrdinalIgnoreCase)
                    && property.Value.ValueKind == JsonValueKind.Number)
                {
                    return property.Value.GetDouble();
                }
            }
        }

        return 0;
    }

    private void PlayPlayback()
    {
        if (trajectory.Count == 0)
            return;

        if (currentPointIndex >= trajectory.Count - 1)
            currentPointIndex = 0;

        playbackCancellation?.Cancel();
        playbackCancellation?.Dispose();

        playbackCancellation = new CancellationTokenSource();
        successMessage = null;
        isPlaying = true;

        _ = PlaybackLoopAsync(playbackCancellation.Token);
    }

    private async Task PlaybackLoopAsync(CancellationToken token)
    {
        try
        {
            while (!token.IsCancellationRequested)
            {
                await Task.Delay(playbackDelayMs, token);

                await InvokeAsync(() =>
                {
                    if (token.IsCancellationRequested || !isPlaying)
                        return;

                    if (currentPointIndex < trajectory.Count - 1)
                    {
                        currentPointIndex++;
                    }

                    if (currentPointIndex >= trajectory.Count - 1)
                    {
                        isPlaying = false;
                        successMessage = "Simulation completed successfully.";
                        consoleLines.Add("Playback completed successfully.");
                    }

                    StateHasChanged();
                });

                if (!isPlaying)
                    break;
            }
        }
        catch (OperationCanceledException)
        {
            // Expected when playback is paused, reset, or restarted.
        }
    }

    private void PausePlayback()
    {
        isPlaying = false;
        playbackCancellation?.Cancel();
    }

    private void ResetPlayback()
    {
        PausePlayback();
        currentPointIndex = 0;
    }

    private void StepBackward()
    {
        PausePlayback();

        if (trajectory.Count > 0)
            currentPointIndex = Math.Max(0, currentPointIndex - 1);
    }

    private void StepForward()
    {
        PausePlayback();

        if (trajectory.Count > 0)
            currentPointIndex = Math.Min(
                trajectory.Count - 1,
                currentPointIndex + 1);
    }

    public void Dispose()
    {
        isPlaying = false;
        playbackCancellation?.Cancel();
        playbackCancellation?.Dispose();
    }

    private List<ProjectileTrajectoryPoint> FilteredTrajectory
    {
        get
        {
            IEnumerable<ProjectileTrajectoryPoint> query = trajectory;

            if (!string.IsNullOrWhiteSpace(tableSearch))
            {
                var term = tableSearch.Trim();

                query = query.Where(p =>
                    p.Time.ToString("F3").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.X.ToString("F3").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.Y.ToString("F3").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.HorizontalVelocity.ToString("F3").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.VerticalVelocity.ToString("F3").Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.Speed.ToString("F3").Contains(term, StringComparison.OrdinalIgnoreCase));
            }

            return query.ToList();
        }
    }

    private int TablePageCount =>
        Math.Max(1, (int)Math.Ceiling(FilteredTrajectory.Count / (double)pageSize));

    private IEnumerable<ProjectileTrajectoryPoint> PagedTrajectory =>
    FilteredTrajectory
        .Skip((tablePage - 1) * pageSize)
        .Take(pageSize);

    private void ResetTablePage()
    {
        tablePage = 1;
    }

    private void PreviousTablePage()
    {
        if (tablePage > 0)
            tablePage--;
    }

    private void NextTablePage()
    {
        if (tablePage < TablePageCount - 1)
            tablePage++;
    }

    private Task HandleTrajectoryPageChanged(int page)
    {
        tablePage = page;
        return Task.CompletedTask;
    }

    private Task HandleTrajectoryPageSizeChanged(int newPageSize)
    {
        pageSize = newPageSize;
        tablePage = 1;
        return Task.CompletedTask;
    }

    
    private void ClearNotes()
    {
        notesTitle = "";
        simulationNotes = "";
        isEditingSavedNotes = false;
        notesSaved = false;
        notesStatus = null;
    }

    private void EditSavedNotes()
    {
        notesTitle = savedNotesTitle;
        simulationNotes = savedNotesContent;
        isEditingSavedNotes = true;
        notesSaved = false;
        notesStatus = null;
    }

    private async Task SaveNotesAsync()
    {
        if (currentSimulationId is null)
        {
            notesStatus = "Run a simulation first before saving notes.";
            notesSaved = false;
            return;
        }

        var titleToSave = !string.IsNullOrWhiteSpace(notesTitle)
            ? notesTitle.Trim()
            : savedNotesTitle;

        string contentToSave;

        if (isEditingSavedNotes)
        {
            // Editing replaces the saved version with the edited version.
            contentToSave = simulationNotes.Trim();
        }
        else if (string.IsNullOrWhiteSpace(simulationNotes))
        {
            notesStatus = "Enter some notes before saving.";
            notesSaved = false;
            return;
        }
        else if (string.IsNullOrWhiteSpace(savedNotesContent))
        {
            // First note for this simulation.
            contentToSave = simulationNotes.Trim();
        }
        else
        {
            // A new entry is appended to the existing saved note.
            contentToSave = savedNotesContent.TrimEnd()
                + Environment.NewLine
                + Environment.NewLine
                + simulationNotes.Trim();
        }

        if (titleToSave.Length > 200)
        {
            notesStatus = "The title cannot exceed 200 characters.";
            notesSaved = false;
            return;
        }

        if (contentToSave.Length > 20000)
        {
            notesStatus = "Combined notes cannot exceed 20,000 characters.";
            notesSaved = false;
            return;
        }

        isSavingNotes = true;
        notesStatus = null;

        try
        {
            var response = await Http.PutAsJsonAsync(
                $"/api/simulations/projectile/history/{currentSimulationId}/notes",
                new
                {
                    NotesTitle = titleToSave,
                    SimulationNotes = contentToSave
                });

            if (response.IsSuccessStatusCode)
            {
                // Update the displayed note only after the backend saves it.
                savedNotesTitle = titleToSave;
                savedNotesContent = contentToSave;

                // Clear the input after a successful save.
                notesTitle = "";
                simulationNotes = "";
                isEditingSavedNotes = false;

                notesSaved = true;
                notesStatus = "Notes saved successfully.";
            }
            else
            {
                notesSaved = false;
                notesStatus =
                    $"Could not save notes. Server returned {(int)response.StatusCode}.";
            }
        }
        catch (HttpRequestException)
        {
            notesSaved = false;
            notesStatus = "Could not connect to the PSS backend. Please try again.";
        }
        finally
        {
            isSavingNotes = false;
        }
    }


    private async Task DeleteSavedNotesAsync()
    {
        if (isDeletingNotes || isSavingNotes)
            return;

        if (string.IsNullOrWhiteSpace(savedNotesTitle)
            && string.IsNullOrWhiteSpace(savedNotesContent))
        {
            notesSaved = false;
            notesStatus = "There are no saved notes to delete.";
            return;
        }

        if (confirmBeforeDeleting)
        {
            showDeleteNotesDialog = true;
            return;
        }

        // Delete directly without displaying the confirmation dialog.
        showDeleteNotesDialog = false;
        await ConfirmDeleteSavedNotesAsync();
    }

    private void CancelDeleteSavedNotes()
    {
        if (isDeletingNotes)
            return;

        showDeleteNotesDialog = false;
    }

    private async Task ConfirmDeleteSavedNotesAsync()
    {
        if (isDeletingNotes)
            return;

        if (currentSimulationId is null)
        {
            notesSaved = false;
            notesStatus = "Open a saved simulation before deleting its notes.";
            showDeleteNotesDialog = false;
            return;
        }

        isDeletingNotes = true;
        notesStatus = null;

        try
        {
            var response = await Http.DeleteAsync(
                $"/api/simulations/projectile/history/{currentSimulationId}/notes");

            if (response.IsSuccessStatusCode)
            {
                savedNotesTitle = "";
                savedNotesContent = "";

                notesTitle = "";
                simulationNotes = "";
                isEditingSavedNotes = false;

                notesSaved = true;
                notesStatus = "Note deleted successfully.";

                showDeleteNotesDialog = false;
            }
            else
            {
                var errorDetails = await response.Content.ReadAsStringAsync();

                notesSaved = false;
                notesStatus =
                    $"Could not delete the note. Server returned " +
                    $"{(int)response.StatusCode}. {errorDetails}";
            }
        }
        catch (HttpRequestException)
        {
            notesSaved = false;
            notesStatus =
                "Could not connect to the PSS backend. Please try again.";
        }
        finally
        {
            isDeletingNotes = false;
        }
    }

    

    private async Task ExportCsvAsync()
    {
        if (trajectory.Count == 0 ||
            isExportingCsv || isExportingNotes ||
            isExportingGraphs || isExportingPdf || isExportingDocx)
            return;

        isExportingCsv = true;
        await InvokeAsync(StateHasChanged);
        await Task.Delay(500);

        try
        {
            await InvokeAsync(StateHasChanged);

            var csv = new StringBuilder();

            string F(double value) =>
                value.ToString("F3", CultureInfo.InvariantCulture);

            csv.AppendLine("PSS - Physics Simulation Studio");
            csv.AppendLine("Simulation Metadata");
            csv.AppendLine($"Simulation Name,{CsvEscape(simulationName)}");
            csv.AppendLine($"Simulation ID,{CsvEscape(currentSimulationId?.ToString() ?? "Not available")}");
            csv.AppendLine($"Module,{CsvEscape(moduleId)}");
            csv.AppendLine($"Exported At,{CsvEscape(DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture))}");
            csv.AppendLine($"Initial Velocity (m/s),{F(initialVelocity)}");
            csv.AppendLine($"Launch Angle (degrees),{F(launchAngle)}");
            csv.AppendLine($"Gravity (m/s²),{F(gravity)}");
            csv.AppendLine($"Initial Height (m),{F(initialHeight)}");
            csv.AppendLine($"Time Step (s),{F(timeStep)}");
            csv.AppendLine($"Range (m),{F(rangeResult)}");
            csv.AppendLine($"Maximum Height (m),{F(maximumHeightResult)}");
            csv.AppendLine($"Time of Flight (s),{F(timeOfFlightResult)}");
            csv.AppendLine($"Final Speed (m/s),{F(finalSpeedResult)}");
            csv.AppendLine($"Total Trajectory Points,{trajectory.Count}");

            csv.AppendLine();
            csv.AppendLine("Trajectory Data");
            csv.AppendLine("Frame,Time (s),X (m),Y (m),Vx (m/s),Vy (m/s),Speed (m/s)");

            for (int i = 0; i < trajectory.Count; i++)
            {
                var point = trajectory[i];

                csv.Append(i + 1).Append(',');
                csv.Append(F(point.Time)).Append(',');
                csv.Append(F(point.X)).Append(',');
                csv.Append(F(point.Y)).Append(',');
                csv.Append(F(point.HorizontalVelocity)).Append(',');
                csv.Append(F(point.VerticalVelocity)).Append(',');
                csv.AppendLine(F(point.Speed));
            }

            await JS.InvokeVoidAsync(
                "pssDownloadFile",
                $"{MakeSafeFileName(simulationName)}.csv",
                "text/csv;charset=utf-8",
                csv.ToString());
        }
        catch (Exception ex)
        {
            pngExportError = $"CSV export failed: {ex.Message}";
        }
        finally
        {
            isExportingCsv = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private static string CsvEscape(string? value)
    {
        value ??= string.Empty;

        return "\"" + value.Replace("\"", "\"\"") + "\"";
    }


