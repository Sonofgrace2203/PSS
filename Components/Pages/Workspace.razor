@page "/SimulationWorkSpace"
@using Microsoft.AspNetCore.Components
@using pss.Components.Shared
@using System.Net.Http.Json
@using System.Text.Json
@using pss.Components.Shared.Graphs
@using System.Linq
@using System.Globalization
@using System.Text
@using pss.Models
@using System.IO
@using pss.Models.SavedSimulationDetails
@using pss.Models.Download
@using pss.Models.Settings
@using Microsoft.AspNetCore.Authorization
@inject IJSRuntime JS

@inject HttpClient Http
@implements IDisposable

@attribute [Authorize]

<div class="hx-08 wvl-5"></div>

<div class="flex flex-spacebetween">
    <div class="mgb-10">
        @if (simulationName.Count() < 1)
        {
            <h2 class="mg-0 fsz-20 cl-primary">Projectile Motion</h2>
        }
        else
        {
            <h2 class="mg-0 fsz-20 cl-primary">@simulationName</h2>
        }
    </div>

    @* <div>
        <i class="mdi mdi-star-outline fsz-25"></i>
        <i class="mdi mdi-share-outline fsz-25"></i>
        <i class="mdi mdi-menu-swap fsz-25"></i>
    </div> *@
</div>

<div class="mgb-10">
    <div class="flex flow flex-start">
        <button class="bd corner-2 pd mgr-1 mgb-1 block bg-primary-01" @onclick="IsSimulation">Simulation</button>

        <button class="bd corner-2 pd mgr-1 mgb-1 block bg-primary-01" @onclick="IsGraph">Graph</button>

        <button class="bd corner-2 pd mgr-1 mgb-1 block bg-primary-01" @onclick="IsDataTable">Data Table</button>
        
        <button class="bd corner-2 pd mgr-1 mgb-1 block bg-primary-01" @onclick="IsNotes">Notes</button>

        <button class="bd corner-2 pd mgr-1 mgb-1 block bg-primary-01" @onclick="IsExport">Export</button>

    </div>
</div>

<div class="scroll-y" style="height: 90vh;">
    <div style="display: @(isSimulation ? "block" : "none");">
        <div class="row responsive miwx-3 mgb">
            <div class="mgt colm-2 miwx-25 mawx-3 pd bg-card corner-2 bdl mgr-5 mgb-10">
                <div class="flex flex-spacebetween flex-center mgb-5">
                    <h3 class="mg-0 pdb-5 fsz-15 pdb"> Parameters</h3>
                    <i class="mdi mdi-menu-down fsz-25 mgt--5 fw-bold"></i>
                </div>

                <div class="mgb-10">
                    <label class="fsz-12">Simulation name *</label>

                    <input type="text" class="corner-2 pd block bd wf mgt-2"
                           placeholder="e.g. Projectile test at 45 degrees" maxlength="100" required
                           disabled="@parametersLocked" @bind="simulationName" @bind:event="oninput" />

                    @if (string.IsNullOrWhiteSpace(simulationName))
                    {
                        <p class="fsz-10 cl-fatal mgt-2">
                            A simulation name is required before running.
                        </p>
                    }
                    else
                    {
                        <p class="fsz-10 op-6 mgt-2">
                            Your experiment name will appear in Saved Results.
                        </p>
                    }
                </div>

                <div class="grid gap-1 colm-3">
                    <div class="mgb-10">
                        <div class="wf mgb-5">
                            <h5 class="mg-0 pdb-2">Initial Velicity (u)</h5>
                            <div class="wf">
                                <input type="number" placeholder="30" class="corner-2 pd block bd wp-80"
                                       disabled="@parametersLocked" @bind="initialVelocity" @bind:event="oninput">
                                
                                <div>
                                    <input type="range" class="wf mgt-2" min="0" max="100" step="1"
                                           disabled="@parametersLocked" @bind="initialVelocity" @bind:event="oninput" />

                                    <div class="flex flex-spacebetween fsz-12">
                                        <span>0 m/s</span>
                                        <span>@initialVelocity.ToString("F0") m/s</span>
                                        <span>100 m/s</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="wf mgb-5">
                            <h5 class="mg-0 pdb-2">Launch Angle (^)</h5>
                            <div class="wf">
                                <input type="number" placeholder="45" class="corner-2 pd block bd wp-80"
                                       disabled="@parametersLocked" @bind="launchAngle" @bind:event="oninput">
                                
                                <div>
                                    <input type="range" class="wf mgt-2" min="0" max="90" step="1" @bind="launchAngle"
                                           disabled="@parametersLocked" @bind:event="oninput" />

                                    <div class="flex flex-spacebetween fsz-12">
                                        <span>0°</span>
                                        <span>@launchAngle.ToString("F0")°</span>
                                        <span>90°</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="wf">
                            <h5 class="mg-0 pdb-2">Gravity (m/r)</h5>
                            <div class="wf">
                                <input type="number" placeholder="0.41" class="corner-2 pd block bd wp-80"
                                       disabled="@parametersLocked" @bind="gravity" @bind:event="oninput">
                            </div>
                        </div>
                    </div>

                    <div class="wf mgb-5">
                        <div class="wf">
                            <button class="corner-2 pd bd wf flex flex-spacebetween mgb-3" @onclick="ToggleMoreOptions"
                                    disabled="@parametersLocked">
                                <span>More Options</span>
                                <i class="mdi @(showMoreOptions ? "mdi-menu-up" : "mdi-menu-down")"></i>
                            </button>

                            @if (showMoreOptions)
                            {
                                <div class="mgt-2 pd bd corner-2">
                                    <div class="mgb-5 clip">
                                        <h5 class="mg-0 pdb-2">Initial Height (m)</h5>
                                        <input type="number" class="corner-2 pd block bd wf" min="0" step="0.5"
                                               disabled="@parametersLocked" @bind="initialHeight" @bind:event="oninput" />
                                    </div>

                                    <div class="clip">
                                        <h5 class="mg-0 pdb-2">Time Step (s)</h5>
                                        <input type="number" class="corner-2 pd block bd wf" min="0.001" max="0.5"
                                               disabled="@parametersLocked" step="any" @bind="timeStep" />
                                        <p class="fsz-10 mgt-3 op-6">
                                            Smaller time steps produce more trajectory points.
                                        </p>
                                    </div>
                                </div>
                            }

                        </div>
                    </div>

                    <div>
                        <button class="bd corner-1 pd" style="cursor: pointer;" @onclick="ResetSimulation"
                                disabled="@isLoadedFromHistory">
                            Reset
                        </button>

                        <button class="bd corner-1 pd bg-primary" style="cursor: pointer;" @onclick="RunSimulation"
                                disabled="@(parametersLocked || string.IsNullOrWhiteSpace(simulationName))">
                            @(isRunning ? "Running..." : isPlaying ? "Playing..." : "Run Simulation")
                        </button>
                    </div>

                    @if (isRunning)
                    {
                        <p class="mg-0 fsz-12 cl-secondary">
                            @(SimulationIdFromQuery.HasValue
                                ? "Loading saved simulation..."
                                : "Running simulation...")
                        </p>
                    }

                    @if (!string.IsNullOrWhiteSpace(successMessage))
                    {
                        <p class="mg-0 fsz-12 cl-success">@successMessage</p>
                    }

                    @if (!string.IsNullOrWhiteSpace(errorMessage))
                    {
                        <p class="mg-0 fsz-12 cl-fatal">@errorMessage</p>
                    }
                </div>
            </div>

            <div style="display: @(runSimulation ? "block" : "none");">
                <div class="mgt colm-25 pd bg-card corner-2 shadow-border-1">

                    
                    <div class="mgb-5 bd corner-2 shadow-border-2 pd">
                        <div class="flex flex-spacebetween">
                            <h4 class="mg-0 pdb fsz-13 cl-primary">Console Output</h4>

                            @if (isRunning)
                            {
                                <p class="mg-0 fsz-12 cl-gray">Calculating</p>
                            }
                            else if (!string.IsNullOrWhiteSpace(errorMessage))
                            {
                                <p class="mg-0 fsz-12 cl-fatal">Failed</p>
                            }
                            else if (isPlaying)
                            {
                                <p class="mg-0 fsz-12 cl-success">Playing</p>
                            }
                            else if (trajectory.Count > 0)
                            {
                                <p class="mg-0 fsz-12 cl-success">Paused / Ready</p>
                            }
                            else
                            {
                                <p class="mg-0 fsz-12 cl-gray">Idle</p>
                            }
                        </div>

                        <div class="mgb-5">
                            <div class="bg-black-01 corner-3 bd hx-01 mgt-2" style="overflow:hidden;">
                                @if (isRunning)
                                {
                                    <div class="bg-success corner-3 hx-01"
                                         style="width:35%; animation: pss-loading 1.2s ease-in-out infinite;">
                                    </div>
                                }
                                else
                                {
                                    <div class="bg-success corner-3 hx-01"
                                         style="width:@(playbackProgress.ToString("F0"))%; transition:width 0.08s linear;">
                                    </div>
                                }
                            </div>

                            <div class="flex flex-spacebetween">
                                <span class="fsz-12">
                                    @(isRunning
                                        ? "Calculating simulation..."
                                        : $"{playbackProgress:F0}%")
                                </span>
                                <span class="fsz-12">
                                    @(isRunning ? "Please wait" : "Playback")
                                </span>
                            </div>
                        </div>


                        <div style="max-height: 240px; overflow-y: auto;">
                            @foreach (var line in consoleLines)
                            {
                                <div class="pdb-1 mgb-1 bdb fsz-12 cl-success" style="overflow-wrap: anywhere;">
                                    @line
                                </div>
                            }

                            @if (consoleLines.Count == 0)
                            {
                                <p class="fsz-12 op-6 cl-error">Run a simulation to view console output.</p>
                            }
                        </div>
                    </div>
                                
                    <div class="mgb-5">
                        <h4 class="mg-0 pdb fsz-13 cl-primary">Live Graph</h4>

                        <div class="wf">
                            <ProjectileMotionLiveGraph Points="trajectory" CurrentPointIndex="currentPointIndex" />
                        </div>

                        <div class="flex flex-spacebetween fsz-12 pdb-1">
                            <span>Time: @CurrentTime.ToString("F2") s</span>
                            <span>Frame: @CurrentFrame / @trajectory.Count</span>
                        </div>

                        <div class="bg-black-01 corner-3 bd hx-01 mgt-2">
                            <div class="bg-secondary corner-3 hx-01"
                                 style="width: @(trajectory.Count > 0 ? playbackProgress : 0)%; transition: width 0.08s linear;">
                            </div>
                        </div>

                        <div class="mgt flex flex-center">
                            <button class="bd pd-1 corner-1 mgr-1 mgb-1 cl-secondary bg-secondary-01"
                                    @onclick="PlayPlayback" disabled="@(trajectory.Count == 0)" title="Play or resume">
                                <i class="mdi mdi-play fsz-25"></i>
                            </button>

                            <button class="bd pd-1 corner-1 mgr-1 mgb-1 cl-secondary bg-secondary-01"
                                    @onclick="StepBackward" disabled="@(trajectory.Count == 0)" title="Previous frame">
                                <i class="mdi mdi-skip-backward fsz-25"></i>
                            </button>

                            <button class="bd pd-1 corner-1 mgr-1 mgb-1 cl-secondary bg-secondary-01"
                                    @onclick="ResetPlayback" disabled="@(trajectory.Count == 0)" title="Reset">
                                <i class="mdi mdi-stop fsz-25"></i>
                            </button>

                            <button class="bd pd-1 corner-1 mgr-1 mgb-1 cl-secondary bg-secondary-01"
                                    @onclick="PausePlayback" disabled="@(!isPlaying)" title="Pause">
                                <i class="mdi mdi-pause fsz-25"></i>
                            </button>

                            <button class="bd pd-1 corner-1 mgr-1 mgb-1 cl-secondary bg-secondary-01"
                                    @onclick="StepForward" disabled="@(trajectory.Count == 0)" title="Next frame">
                                <i class="mdi mdi-skip-forward fsz-25"></i>
                            </button>

                            <select class="bd corner-1 pd-1 bg-transparent" @bind="playbackDelayMs"
                                    title="Playback speed">
                                <option value="120">0.5x</option>
                                <option value="60">1x</option>
                                <option value="30">2x</option>
                            </select>
                        </div>

                    </div>

                    <div class="bg-primary-01 flex flex-spacearound corner-2 pd bd wvg-5">
                        <div class="flex flex-center stack bdr wf">
                            <h5 class="mg-0 pdb op-5">Range</h5>
                            <h4 class="mg-0">@rangeResult.ToString("F2") m</h4>
                        </div>
                        <div class="flex flex-center stack bdr wf">
                            <h5 class="mg-0 pdb op-5">Max Height</h5>
                            <h4 class="mg-0">@maximumHeightResult.ToString("F2") m</h4>
                        </div>
                        <div class="flex flex-center stack bdr wf">
                            <h5 class="mg-0 pdb op-5">Time of Flight</h5>
                            <h4 class="mg-0">@timeOfFlightResult.ToString("F2") s</h4>
                        </div>
                        <div class="flex flex-center stack wf">
                            <h5 class="mg-0 pdb op-5">Final Velocity</h5>
                            <h4 class="mg-0">@finalSpeedResult.ToString("F2") m/s</h4>
                        </div>
                    </div>

                    <div class="bg-primary-01 grid gap-1 colm-15 corner-2 pd bd wvl-5">
                        <div class="flex flex-center stack bdr wf mgb-5 mgt-5">
                            <h5 class="mg-0 pdb op-5">Range</h5>
                            <h4 class="mg-0">@rangeResult.ToString("F2") m</h4>
                        </div>
                        <div class="flex flex-center stack wf mgb-5 mgt-5">
                            <h5 class="mg-0 pdb op-5">Max Height</h5>
                            <h4 class="mg-0">@maximumHeightResult.ToString("F2") m</h4>
                        </div>
                        <div class="flex flex-center stack bdr wf mgb-5 mgt-5">
                            <h5 class="mg-0 pdb op-5">Time of Flight</h5>
                            <h4 class="mg-0">@timeOfFlightResult.ToString("F2") s</h4>
                        </div>
                        <div class="flex flex-center stack wf mgb-5 mgt-5">
                            <h5 class="mg-0 pdb op-5">Final Velocity</h5>
                            <h4 class="mg-0">@finalSpeedResult.ToString("F2") m/s</h4>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>


    @* <div style="display: @(isGraph ? "block" : "none");"> *@
    <div
        style="@(isGraph ? "display: block;" : "position: fixed; left: -10000px; top: 0; width: 1200px; display: block; visibility: hidden; pointer-events: none;")">
        <h3 class="mg-0 text-center pdb-10 fsz-16">
            Projectile Motion - Graphs
        </h3>

        <div class="grid gap-1 colm-35">
            <div>
                <h5 class="text-center mg-0 pdb-5">
                    Position vs Time
                </h5>
                <div class="pd bd corner-2 shadow-border-1">
                    <ProjectileAnalysisGraph @ref="positionGraph" Points="trajectory" Title="Position vs Time"
                                             GraphType="position" Gravity="gravity" />
                </div>
            </div>

            <div>
                <h5 class="text-center mg-0 pdb-5">
                    Velocity vs Time
                </h5>
                <div class="pd bd corner-2 shadow-border-1">
                    <ProjectileAnalysisGraph @ref="velocityGraph" Points="trajectory" Title="Velocity vs Time"
                                             GraphType="velocity" Gravity="gravity" />
                </div>
            </div>

            <div>
                <h5 class="text-center mg-0 pdb-5">
                    Energy vs Time
                </h5>
                <div class="pd bd corner-2 shadow-border-1">
                    <ProjectileAnalysisGraph @ref="energyGraph" Points="trajectory" Title="Energy vs Time"
                                             GraphType="energy" Gravity="gravity" />
                </div>
            </div>

            <div>
                <h5 class="text-center mg-0 pdb-5">
                    Displacement vs Time
                </h5>
                <div class="pd bd corner-2 shadow-border-1">
                    <ProjectileAnalysisGraph @ref="displacementGraph" Points="trajectory" Title="Displacement vs Time"
                                             GraphType="displacement" Gravity="gravity" />
                </div>
            </div>
        </div>



    </div>



    <div style="display: @(isDataTable ? "block" : "none");">

        <div class="mgb-10">
            <h3 class="mg-0 pdb-2 fsz-16">Simulation Data Table</h3>
            <p class="fsz-12 op-6 mg-0">
                Numerical results for each projectile trajectory point.
            </p>
        </div>

        @if (trajectory.Count == 0)
        {
            <div class="pd bg-card corner-2 bd">
                <h4 class="mg-0 pdb-2">No simulation data yet</h4>
                <p class="mg-0 fsz-12 op-6">
                    Open the Simulation tab and run a projectile simulation.
                    Its numerical results will appear here.
                </p>
                <button class="bd corner-2 pd mgt-2 bg-primary-01" @onclick="IsSimulation">
                    Go to Simulation
                </button>
            </div>
        }
        else
        {
            <div class="grid gap-1 colm-3 mgb-10">
                <div class="pd corner-2 bg-primary-01 cl-primary">
                    <div class="fsz-12 op-6">Total data points</div>
                    <h3 class="mg-0">@trajectory.Count</h3>
                </div>

                <div class="pd corner-2 bg-primary-01 cl-primary">
                    <div class="fsz-12 op-6">Current time</div>
                    <h3 class="mg-0">@CurrentTime.ToString("F2") s</h3>
                </div>

                <div class="pd corner-2 bg-primary-01 cl-primary">
                    <div class="fsz-12 op-6">Current frame</div>
                    <h3 class="mg-0">@CurrentFrame / @trajectory.Count</h3>
                </div>
            </div>

            <div class="pd bd bg-card corner-2 mgb-10 clip">
                <label class="fsz-12">Search trajectory data</label>
                <input type="text" class="bd corner-2 pd wf mgt-2" placeholder="Search time, position, velocity..."
                       @bind="tableSearch" @bind:event="oninput" @bind:after="ResetTablePage" />

                <div class="mgt-2 mgb-2">
                    <span class="fsz-12 op-6">
                        @FilteredTrajectory.Count matching rows
                    </span>
                </div>
            </div>

            <div class="scroll-y" style="height: 70vh;">
                <div style="overflow-x:auto; max-width:100%;" class="bd corner-2">
                    <table style="width:100%; border-collapse:collapse; min-width:850px;">
                        <thead>
                            <tr class="bg-primary-01">
                                <th class="cl-primary text-left" style="padding:12px;">Frame</th>
                                <th class="cl-primary text-left" style="padding:12px;">Time (s)</th>
                                <th class="cl-primary text-left" style="padding:12px;">X (m)</th>
                                <th class="cl-primary text-left" style="padding:12px;">Y (m)</th>
                                <th class="cl-primary text-left" style="padding:12px;">Vx (m/s)</th>
                                <th class="cl-primary text-left" style="padding:12px;">Vy (m/s)</th>
                                <th class="cl-primary text-left" style="padding:12px;">Speed (m/s)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in PagedTrajectory)
                            {
                                var frame = trajectory.IndexOf(item);
                                var isCurrent = frame == currentPointIndex;

                                <tr style="border-top:1px solid #8884;
                                    background:@(isCurrent ? "rgba(40,130,220,0.15)" : "transparent");">
                                    <td class="cl-primary" style="padding:12px;">@(frame + 1)</td>
                                    <td style="padding:12px;">@item.Time.ToString("F3")</td>
                                    <td style="padding:12px;">@item.X.ToString("F3")</td>
                                    <td style="padding:12px;">@item.Y.ToString("F3")</td>
                                    <td style="padding:12px;">@item.HorizontalVelocity.ToString("F3")</td>
                                    <td style="padding:12px;">@item.VerticalVelocity.ToString("F3")</td>
                                    <td style="padding:12px;">@item.Speed.ToString("F3")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <Pagination CurrentPage="@tablePage" TotalPages="@TablePageCount" TotalItems="@FilteredTrajectory.Count"
                        PageSize="@pageSize" ItemLabel="row" CurrentPageChanged="HandleTrajectoryPageChanged"
                        PageSizeChanged="HandleTrajectoryPageSizeChanged" />
        }
    </div>


    <div style="display: @(isNotes ? "block" : "none");">

        <div class="mgb-10">
            <h3 class="mg-0 pdb-2 fsz-16">Simulation Notes</h3>
            <p class="fsz-12 op-6 mg-0">
                Record your experiment setup, observations, and conclusions.
            </p>
        </div>

        @* Note editor *@
        <div class="pd bd bg-card corner-2 clip">
            <label class="fsz-12">Experiment title</label>
            <input class="bd corner-2 pd wf mgt-2 mgb-10" placeholder="e.g. Projectile launched at 45 degrees"
                   maxlength="200" @bind="notesTitle" />

            <label class="fsz-12">
                @(isEditingSavedNotes ? "Edit saved observations and conclusions"
                                      : "Add observations and conclusions")
            </label>

            <textarea class="bd corner-2 pd wf mgt-2" rows="8" maxlength="20000"
                      placeholder="Record what you observed during the simulation..." @bind="simulationNotes"></textarea>

            <div class="flex flex-spacebetween flex-center mgt-2">
                <span class="fsz-12 op-6">
                    @simulationNotes.Length characters
                </span>

                <div class="flex">
                    <button class="bd corner-2 pd bg-primary-01 mgr-1" style="cursor: pointer;" @onclick="ClearNotes">
                        Clear input
                    </button>

                    <button class="bd corner-2 pd bg-primary" style="cursor: pointer;" @onclick="SaveNotesAsync"
                            disabled="@(isSavingNotes || isDeletingNotes)">
                        @(isSavingNotes ? "Saving..." : "Save Notes")
                    </button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(notesStatus))
            {
                <p class="fsz-12 mgt-2 @(notesSaved ? "cl-success" : "cl-fatal")" role="status">
                    @notesStatus
                </p>
            }

            <p class="fsz-12 op-6 mgt-2">
                Save your notes to keep them in the database for this simulation.
            </p>
        </div>

        @* Saved note display *@
        <div class="mgt-10">
            <h3 class="mg-0 pdb-2 fsz-16">Saved Notes</h3>

            @if (string.IsNullOrWhiteSpace(savedNotesTitle)
                && string.IsNullOrWhiteSpace(savedNotesContent))
            {
                <div class="bg-card corner-2">
                    <p class="mg-0 fsz-12 op-6">
                        No saved notes yet. Your saved note will appear here.
                    </p>
                </div>
            }
            else
            {
                <div class="pd bd bg-card corner-2">
                    <div class="flex flex-spacebetween flex-center mgb-2">
                        <h4 class="mg-0 cl-primary">
                            @(string.IsNullOrWhiteSpace(savedNotesTitle)
                                ? "Untitled Note"
                                : savedNotesTitle)
                        </h4>

                        <div class="flex flex-center" style="gap: 6px;">
                            <button class="bd corner-2 pd bg-primary-01 mdi mdi-pencil fsz-20 fw-bold"
                                    style="cursor: pointer;" title="Edit saved note" aria-label="Edit saved note"
                                    @onclick="EditSavedNotes">
                                <icon name="pencil" size="16" />
                            </button>

                            <button class="bd corner-2 pd bg-error mdi mdi-delete fsz-20 fw-bold" title="Delete saved note"
                                    style="cursor: pointer;" aria-label="Delete saved note" @onclick="DeleteSavedNotesAsync"
                                    disabled="@isSavingNotes">
                                <icon name="trash-2" size="16" />
                            </button>
                        </div>
                    </div>

                    <p class="fsz-12 op-6 mgb-2">
                        Projectile Motion Experiment
                    </p>

                    <div class="flex flex-start pd">
                        <div class="flex flex-center">
                            <i class="mdi mdi-pen-plus fsz-20 cl-primary mgr-5"></i>
                            <div style="white-space: pre-wrap; overflow-wrap: anywhere; max-height: 70vh;" class="scroll-y">
                                @savedNotesContent
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>


    <div style="display: @(isExport ? "block" : "none");">

        <div class="mgb-10">
            <h3 class="mg-0 pdb-2 fsz-16">Export Simulation</h3>
            <p class="fsz-12 op-6 mg-0">
                Download your numerical results and experiment notes.
            </p>
        </div>

        <div class="grid gap-1 colm-2 mgb-10">
            <div class="pd bd bg-card corner-2">
