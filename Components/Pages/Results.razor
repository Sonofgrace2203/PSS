@page "/SimulationResult"
@using pss.Components.Shared
@using System.Net.Http.Json
@using System.Globalization
@using pps.Model.SavedSimulationRow
@using pss.Models.SavedSimulationDetails;
@using pss.Models.Dtos
@using pss.Models.Settings
@using Microsoft.AspNetCore.Authorization

@inject HttpClient Http
@inject NavigationManager Nav

@attribute [Authorize]

<div class="hx-08 wvl-5"></div>

<div class="flex flex-spacebetween flow">
    <div class="mgb-10">
        <h2 class="mg-0 fsz-20 cl-primary">Saved Results</h2>
        <p class="mg-0 fsz-13">View and manage your saved simulations</p>
    </div>

    <div>
        <input type="text" placeholder="🔍 Search saved results" class="wx-3 pd corner-2 bd-none bd mgb-5"
               @bind="searchTerm" @bind:event="oninput" />
    </div>
</div>

@if (isLoading)
{
    <div class="wf flex flex-center align-justify align-center" style="height:70vh">
        <LoadingIndicator IsLoading="@isLoading" Message="Loading saved simulations..."/>
    </div>
}
else if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="wf flex flex-center align-justify align-center" style="height:70vh">
        <p class="mgt-5 cl-fatal fsz-12" role="alert">@errorMessage</p>
        <button class="bd corner-2 pd bg-primary-01 fsz-10" @onclick="LoadHistoryAsync">
            Retry
        </button>
    </div>
}
else
{
    @if (selectedSimulation is not null)
    {
        <div class="pd bd corner-2 mgt-5">
            <div class="flex flex-spacebetween flex-center">
                <h3 class="mg-0 fsz-16 cl-primary">
                    Saved Simulation Details
                </h3>

                <button class="bd corner-2 pd bg-primary-01" @onclick="CloseDetails">
                    Close
                </button>
            </div>

            <p class="mgt-2">
                <strong>Simulation ID:</strong>
                @selectedSimulation.SimulationId
            </p>

            <p>
                <strong>Saved:</strong>
                @selectedSimulation.CreatedAtUtc.ToLocalTime()
                .ToString("dd MMM yyyy, hh:mm tt", CultureInfo.InvariantCulture)
            </p>

            <p>
                <strong>Initial velocity:</strong>
                @selectedSimulation.InitialVelocity.ToString("F2") m/s
            </p>

            <p>
                <strong>Launch angle:</strong>
                @selectedSimulation.LaunchAngle.ToString("F2")°
            </p>

            <p>
                <strong>Gravity:</strong>
                @selectedSimulation.Gravity.ToString("F2") m/s²
            </p>

            <p>
                <strong>Initial height:</strong>
                @selectedSimulation.InitialHeight.ToString("F2") m
            </p>

            <p>
                <strong>Range:</strong>
                @selectedSimulation.Range.ToString("F2") m
            </p>

            <p>
                <strong>Maximum height:</strong>
                @selectedSimulation.MaximumHeight.ToString("F2") m
            </p>

            <p>
                <strong>Time of flight:</strong>
                @selectedSimulation.TimeOfFlight.ToString("F2") s
            </p>

            <div class="mgt-25">
                <h4 class="mg-0 fsz-15 cl-primary">Saved Notes</h4>

                @if (string.IsNullOrWhiteSpace(selectedSimulation.NotesTitle)
                    && string.IsNullOrWhiteSpace(selectedSimulation.SimulationNotes))
                {
                    <p class="fsz-13 op-6">
                        No notes have been saved for this simulation.
                    </p>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(selectedSimulation.NotesTitle))
                    {
                        <h5 class="fsz-14">
                            @selectedSimulation.NotesTitle
                        </h5>
                    }

                    <p style="white-space: pre-wrap;">@selectedSimulation.SimulationNotes</p>
                }
            </div>
        </div>
    }


    @if (simulationPendingDelete.HasValue)
    {
        <ConfirmDialog TitleStart="Delete saved simulation?" TitleAction="1"
                       SubTitle="This will permanently delete the selected simulation and its saved notes. This action cannot be undone."
                       CancelButtonAble="@isDeleting" OnCancel="CancelDelete" ConfirmButtonAble="@isDeleting"
                       OnConfirm="ConfirmDeleteAsync" ConfirmButtonProcess="@(isDeleting ? "Deleting..." : "Yes, delete")" />
    }

    @if (showBulkDeleteConfirmation)
    {
        <ConfirmDialog TitleStart="Delete" TitleAction="@selectedSimulationIds.Count" TitleEnd="selected simulations"
                       SubTitle="This permanently deletes the selected simulations and their saved notes. This action cannot be undone."
                       CancelButtonAble="@isDeleting" OnCancel="() => showBulkDeleteConfirmation = false" ConfirmButtonAble="@isDeleting"
                       OnConfirm="ConfirmBulkDeleteAsync"
                       ConfirmButtonProcess="@(isDeleting ? "Deleting..." : "Yes, delete all selected")" />
    }
    
    <div class="wf mgt">
        @if (selectedSimulationIds.Count > 0)
        {
            <div class="flex flex-spacebetween flex-center flow mgb-5">
                <label class="flex flex-center mgb-3" style="gap: 8px;">
                    <input type="checkbox" checked="@AreAllVisibleSelected" disabled="@isDeleting"
                           @onchange="ToggleSelectAll" />
                    Select all visible
                </label>

                <div>
                    <button class="bd corner-2 pd" style="background-color: #b42318; color: white;" disabled="@isDeleting"
                            @onclick="RequestBulkDelete">
                        Delete selected (@selectedSimulationIds.Count)
                    </button>

                    <button class="bd corner-2 pd bg-primary-01" @onclick="CancelBulkDelete">
                        Cancel
                    </button>
                </div>
            </div>
        }

        <div class="scroll-y" style="height: 90vh;">
            <div style="overflow-x:auto; max-width:100%;" class="bd corner-2">
                <table style="width:100%; border-collapse:collapse; min-width:850px;">
                    <thead>
                        <tr class="bg-primary-01">
                            <th class="cl-primary text-left" style="padding:12px;">Select</th>
                            <th class="cl-primary text-left" style="padding:12px;">Image</th>
                            <th class="cl-primary text-left" style="padding:12px;">Name</th>
                            <th class="cl-primary text-left" style="padding:12px;">Parameters</th>
                            <th class="cl-primary text-left" style="padding:12px;">Date</th>
                            <th class="cl-primary text-left" style="padding:12px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (FilteredSimulation.Count == 0)
                        {
                            <td colspan="6" class="pd text-center fsz-12" style="height: 70vh;">
                                No saved simulations found.
                            </td>
                        }
                        else
                        {
                            @foreach (var simulation in PagedSimulations)
                            {
                                <tr @key="simulation.SimulationId" style="border-top:1px solid #8884;">
                                    <td class="cl-primary" style="padding:12px;">
                                        <input type="checkbox" checked="@selectedSimulationIds.Contains(simulation.SimulationId)"
                                               disabled="@isDeleting" @onchange="(e) => ToggleSimulationSelection(
                                               simulation.SimulationId,
                                               e.Value is bool selected && selected)" />
</td>

                                    <td style="padding:12px;">
                                        @if (!string.IsNullOrWhiteSpace(GetModuleImage("projectile")))
                                        {
                                            <img src="@GetModuleImage("projectile")" alt="Projectile Motion" class="wx-04 hx-04"
                                                 style="object-fit:cover; border-radius:8px;" />
                                        }
                                        else
                                        {
                                            <span class="fsz-12 op-6">No image</span>
                                        }
                                    </td>

                                    <td style="padding:12px;">
                                        <strong>@simulation.Name</strong>
                                        <p class="mg-0 fsz-13 op-6">
                                            Range: @simulation.Range.ToString("F2") m
                                        </p>
                                    </td>

                                    <td style="padding:12px;">
                                        @simulation.InitialVelocity.ToString("F2") m/s,
                                        @simulation.LaunchAngle.ToString("F2")°
                                    </td>

                                    <td style="padding:12px;">
                                        @simulation.CreatedAtUtc.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt",
                        CultureInfo.InvariantCulture)
                                    </td>

                                    <td style="padding:12px;">
                                        <button class="bd-none bg-transparent mgr-3" title="Open simulation in Workspace" style="cursor: pointer;"
                                                aria-label="Open simulation in Workspace"
                                                @onclick="() => OpenInWorkspace(simulation.SimulationId)">
                                            <i class="mdi mdi-eye fsz-20 cl-secondary"></i>
                                        </button>

                                        <button class="bd-none bg-transparent" title="Delete saved simulation" style="cursor: pointer;"
                                                aria-label="Delete saved simulation" disabled="@isDeleting"
                                                @onclick="() => RequestDelete(simulation.SimulationId)">
                                            <i class="mdi mdi-delete fsz-20 cl-fatal"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <Pagination CurrentPage="@CurrentPage" TotalPages="@TotalPages" TotalItems="@FilteredSimulation.Count"
                    PageSize="@PageSize" ItemLabel="simulation" CurrentPageChanged="HandlePageChanged"
                    PageSizeChanged="HandlePageSizeChanged" />
    </div>
}

@code {
    private List<SavedSimulationRow> savedSimulations = new();
    private SavedSimulationDetails? selectedSimulation;
    private List<DashboardModuleDto> modules = new();

    private string searchTerm = "";
    private string? errorMessage;
    private bool isLoading = true;
    private bool isOpeningDetails;
    private Guid? simulationPendingDelete;
    private bool isDeleting;
    private bool showBulkDeleteConfirmation;
    private bool confirmBeforeDeleting = true;

    private int CurrentPage = 1;
    private int PageSize = 10;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredSimulation.Count / (double)PageSize));

    private List<SavedSimulationRow> FilteredSimulations =>
        savedSimulations
            .Where(simulation =>
                string.IsNullOrWhiteSpace(searchTerm)
                || "Projectile Motion".Contains(
                    searchTerm.Trim(),
                    StringComparison.OrdinalIgnoreCase)
                || simulation.SimulationId.ToString().Contains(
                    searchTerm.Trim(),
                    StringComparison.OrdinalIgnoreCase)
                || simulation.Range.ToString(
                    CultureInfo.InvariantCulture).Contains(searchTerm.Trim(),
                    StringComparison.OrdinalIgnoreCase)
                || simulation.InitialVelocity.ToString(
                    CultureInfo.InvariantCulture).Contains(searchTerm.Trim(),
                    StringComparison.OrdinalIgnoreCase))
            .ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadDeleteConfirmationSettingAsync();
        await LoadHistoryAsync();
    }

    private async Task LoadHistoryAsync()
    {
        isLoading = true;
        errorMessage = null;

        try
        {
            var historyTask =
                Http.GetFromJsonAsync<List<SavedSimulationRow>>(
                    "/api/simulations/projectile/history?limit=100");

            var modulesTask =
                Http.GetFromJsonAsync<List<DashboardModuleDto>>(
                    "/api/modules/");

            await Task.WhenAll(historyTask, modulesTask);

            savedSimulations = await historyTask ?? new();
            modules = await modulesTask ?? new();
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not connect to the PSS backend. Check that the API is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage =
                "The saved simulation history could not be read. Check the API response format.";
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadDeleteConfirmationSettingAsync()
    {
        try
        {
            var settings = await Http.GetFromJsonAsync<GeneralSettingsResponse>(
                "/api/settings/general/");

            if (settings is not null)
            {
                confirmBeforeDeleting = settings.ConfirmBeforeDeleting;
            }
        }
        catch (HttpRequestException)
        {
            // Keep confirmation enabled if the setting cannot be loaded.
        }
        catch (System.Text.Json.JsonException)
        {
            // Keep confirmation enabled if the response cannot be read.
        }
    }

    private async Task OpenSimulationAsync(Guid simulationId)
    {
        isOpeningDetails = true;
        errorMessage = null;

        try
        {
            selectedSimulation =
                await Http.GetFromJsonAsync<SavedSimulationDetails>(
                    $"/api/simulations/projectile/history/{simulationId}");

            if (selectedSimulation is null)
            {
                errorMessage = "The selected simulation was not found.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not retrieve this simulation. Please check your backend connection.";
        }
        catch (System.Text.Json.JsonException)
        {
            errorMessage =
                "The saved simulation details could not be read.";
        }
        finally
        {
            isOpeningDetails = false;
        }
    }
    
    private string GetModuleImage(string? moduleId)
    {
        if (string.IsNullOrWhiteSpace(moduleId))
            return string.Empty;

        var module = modules.FirstOrDefault(m =>
            string.Equals(
                m.Slug,
                moduleId,
                StringComparison.OrdinalIgnoreCase));

        return module?.ImageUrl ?? string.Empty;
    }


    private List<SavedSimulationRow> FilteredSimulation =>
    savedSimulations
        .Where(simulation =>
            string.IsNullOrWhiteSpace(searchTerm)
            || (simulation.Name ?? "").Contains(
                searchTerm.Trim(),
                StringComparison.OrdinalIgnoreCase)
            || simulation.SimulationId.ToString().Contains(
                searchTerm.Trim(),
                StringComparison.OrdinalIgnoreCase)
            || simulation.Range.ToString(
                CultureInfo.InvariantCulture).Contains(
                searchTerm.Trim(),
                StringComparison.OrdinalIgnoreCase)
            || simulation.InitialVelocity.ToString(
                CultureInfo.InvariantCulture).Contains(
                searchTerm.Trim(),
                StringComparison.OrdinalIgnoreCase))
        .ToList();

    private List<SavedSimulationRow> PagedSimulations =>
    FilteredSimulation
        .Skip((CurrentPage - 1) * PageSize)
        .Take(PageSize)
        .ToList();


    private Task HandlePageChanged(int page)
    {
        CurrentPage = page;
        return Task.CompletedTask;
    }

    private Task HandlePageSizeChanged(int pageSize)
    {
        PageSize = pageSize;
        CurrentPage = 1;
        return Task.CompletedTask;
    }

    private string? successMessage;
    private async Task RequestDelete(Guid simulationId)
    {
        if (isDeleting)
            return;

        errorMessage = null;

        if (confirmBeforeDeleting)
        {
            simulationPendingDelete = simulationId;
            return;
        }

        simulationPendingDelete = null;
        await DeleteSimulationAsync(simulationId);
    }

    private void CancelDelete()
    {
        if (!isDeleting)
        {
            simulationPendingDelete = null;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (!simulationPendingDelete.HasValue || isDeleting)
            return;

        var simulationId = simulationPendingDelete.Value;

        await DeleteSimulationAsync(simulationId);
    }

    private async Task DeleteSimulationAsync(Guid simulationId)
    {
        if (isDeleting)
            return;

        isDeleting = true;
        errorMessage = null;

        try
        {
            using var response = await Http.DeleteAsync(
                $"/api/simulations/projectile/history/{simulationId}");

            if (response.IsSuccessStatusCode ||
                response.StatusCode == System.Net.HttpStatusCode.NotFound)
            {
                savedSimulations.RemoveAll(
                    simulation => simulation.SimulationId == simulationId);

                if (selectedSimulation?.SimulationId == simulationId)
                {
                    selectedSimulation = null;
                }

                simulationPendingDelete = null;
            }
            else
            {
                errorMessage =
                    $"Could not delete the simulation (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Could not connect to the backend. The simulation was not confirmed deleted.";
        }
        finally
        {
            isDeleting = false;
        }
    }


    private HashSet<Guid> selectedSimulationIds = new();

    private bool AreAllVisibleSelected =>
        FilteredSimulations.Count > 0 &&
        FilteredSimulations.All(
            simulation => selectedSimulationIds.Contains(simulation.SimulationId));

    private void ToggleSimulationSelection(Guid simulationId, bool isSelected)
    {
        if (isSelected)
            selectedSimulationIds.Add(simulationId);
        else
            selectedSimulationIds.Remove(simulationId);
    }

    private void ToggleSelectAll(ChangeEventArgs e)
    {
        bool selectAll = e.Value is bool value && value;

        foreach (var simulation in FilteredSimulations)
        {
            if (selectAll)
                selectedSimulationIds.Add(simulation.SimulationId);
            else
                selectedSimulationIds.Remove(simulation.SimulationId);
        }
    }

    private async Task RequestBulkDelete()
    {
        if (selectedSimulationIds.Count == 0 || isDeleting)
            return;

        simulationPendingDelete = null;
        errorMessage = null;

        if (confirmBeforeDeleting)
        {
            showBulkDeleteConfirmation = true;
        }
        else
        {
            await ConfirmBulkDeleteAsync();
        }
    }


    private async Task ConfirmBulkDeleteAsync()
    {
        if (selectedSimulationIds.Count == 0 || isDeleting)
        {
            return;
        }

        isDeleting = true;
        errorMessage = null;

        var idsToDelete = selectedSimulationIds.ToList();
        var failedIds = new List<Guid>();

        try
        {
            foreach (var id in idsToDelete)
            {
                try
                {
                    using var response = await Http.DeleteAsync(
                        $"/api/simulations/projectile/history/{id}");

                    if (response.IsSuccessStatusCode ||
                        response.StatusCode == System.Net.HttpStatusCode.NotFound)
                    {
                        savedSimulations.RemoveAll(
                            simulation => simulation.SimulationId == id);

                        if (selectedSimulation?.SimulationId == id)
                            selectedSimulation = null;

                        selectedSimulationIds.Remove(id);
                    }
                    else
                    {
                        failedIds.Add(id);
                    }
                }
                catch (HttpRequestException)
                {
                    failedIds.Add(id);
                }
            }

            showBulkDeleteConfirmation = false;

            if (failedIds.Count > 0)
            {
                errorMessage =
                    $"Could not delete {failedIds.Count} simulation(s). " +
                    "The remaining selections have been kept so you can retry.";
            }
            else
            {
                selectedSimulationIds.Clear();
            }
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void CancelBulkDelete()
    {
        if (isDeleting)
            return;

        showBulkDeleteConfirmation = false;
        selectedSimulationIds.Clear();
    }

    private void CloseDetails()
    {
        selectedSimulation = null;
    }

    private void OpenInWorkspace(Guid simulationId)
    {
        Nav.NavigateTo($"SimulationWorkSpace?id={simulationId}");
    }
}
