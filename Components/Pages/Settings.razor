        @* DATA & STORAGE TAB *@
        @* <div class="settings-tab-content" id="dataStorageTab" style="display: @(isStorage ? "block" : "none");">
            <div class="mgb-10">
                <h3 class="fsz-15 mgb-2 cl-primary">Data & Storage</h3>
                <p class="text-muted fsz-12">
                    Manage simulation data, saving preferences, and exported files.
                </p>
            </div>

            <div class="settings-card mgb-5 pd bdl corner-2">
                <h4 class="mg-0 fsz-15">Data Preferences</h4>

                <div class="flex flex-spacebetween mgt-5">
                    <div>
                        <p class="fsz-12">
                            Automatically save simulation results when supported.
                        </p>
                    </div>
