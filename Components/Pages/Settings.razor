@page "/Settings"
@using pss.Components.Shared
@using System.Net.Http.Json
@using System.Net.Http
@using pss.Models.Settings
@using Microsoft.AspNetCore.Authorization
@inject HttpClient Http

@attribute [Authorize]

<div class="hx-08 wvl-5"></div>

<div class="flex flex-spacebetween flow">
    <div class="mgb-10 cl-primary">
        <h2 class="mg-0 fsz-20">Settings</h2>
        <p class="mg-0 fsz-13">Customize your experience</p>
    </div>

    <button class="mdi mdi-tools fsz-25 round wx-05 hx-05 pd-1 bd-none bg-secondary-01 cl-secondary"
            style="cursor: pointer;" @onclick="IsSetting"></button>
</div>

<div class="row responsive colm-3">
    <div class="flex flex-start stack miwx-15 mawx-25 mgb-5" style="display: @(!isSetting ? "block" : "none");">
        <button class="bg-transparent bd-none bdl pd mgb-3 block setting-btn" @onclick="IsGeneral">
            <i class="mdi mdi-tools fsz-20"></i>
            General
        </button>

        @* <button class="bg-transparent bd-none bdl pd mgb-3 block setting-btn" @onclick="IsAppearance">
            <i class=" mdi mdi-view-agenda-outline fsz-20"></i>
            Appearance
        </button> *@

        <button class="bg-transparent bd-none bdl pd mgb-3 block setting-btn" @onclick="IsLimit">
            <i class=" mdi mdi-console fsz-20"></i>
            Limits & Constants
        </button>

        @* <button class="bg-transparent bd-none bdl pd mgb-3 block setting-btn" @onclick="IsParameters">
            <i class=" mdi mdi-parachute-outline fsz-20"></i>
            Default Parameters
        </button> *@

        @* <button class="bg-transparent bd-none bdl pd mgb-3 block setting-btn" @onclick="IsStorage">
            <i class="mdi mdi-store-alert fsz-20"></i>
            Date & Storage
        </button> *@

        <button class="bg-transparent bd-none bdl pd mgb-3 block setting-btn" @onclick="IsAbout">
            <i class=" mdi mdi-alert-circle-check fsz-20"></i>
            About
        </button>
    </div>

    <div class="wf miwx-25 pd corner-2 shadow-border-1">

        <div style="display: @(isGeneral ? "block" : "none");">
            <h3 class="fsz-15 mgb-5 cl-primary">General Settings</h3>
            @if (isLoadingGeneralSettings)
            {
                <p class="fsz-12 op-6">Loading general settings...</p>
            }

            @if (!string.IsNullOrWhiteSpace(generalSettingsError))
            {
                <p class="fsz-12 cl-fatal mgb-10" role="alert">@generalSettingsError</p>
            }

            @if (!string.IsNullOrWhiteSpace(generalSettingsMessage))
            {
                <p class="fsz-12 cl-success mgb-10" role="status">@generalSettingsMessage</p>
            }

            <div>
                @* <div class="stack mgb-7">
                    <label for="Language" class="fsz-12 mgb-2">Language</label>
                    <select name="" id="" class="pd corner-1 bd">
                        <option value="">English</option>
                    </select>
                </div>

                <div class="stack mgb-7">
                    <label for="Language" class="fsz-12 mgb-2">Default Theme</label>
                    <div class="flex flex-start flow">
                        <div class="bd bg-primary-01 pd flex flex-center mgr-3">
                            <input type="radio" class="mgr-3">Light
                        </div>
                        <div class="bd bg-primary-01 pd flex flex-center mgr-3">
                            <input type="radio" class="mgr-3">Dark
                        </div>
                        <div class="bd bg-primary-01 pd flex flex-center">
                            <input type="radio" class="mgr-3">Systems
                        </div>
                    </div>
                </div>

                <div class="stack mgb-7">
                    <label for="Language" class="fsz-12 mgb-2">Animation Quality</label>
                    <select name="" id="" class="pd corner-1 bd">
                        <option value="">High</option>
                    </select>
                </div> *@

                <div class="mgt-5">
                    <div class="flex flex-spacebetween mgb-5">
                        <label for="Language" class="fsz-12 mgb-2">Show Tips on StartUp</label>
                        <div class="bg-primary hx-02 wx-04 corner-3 pd-1 flex @(showTipsOnStartup ? "flex-end" : "flex-start")"
                             role="switch" aria-checked="@showTipsOnStartup" style="cursor: pointer;"
                             @onclick="() => UpdateGeneralSettingAsync(nameof(showTipsOnStartup), !showTipsOnStartup)">
                            <div class="bg-card round hf wx-02"></div>
                        </div>
                    </div>

                    <div class="flex flex-spacebetween mgb-5">
                        <label for="Language" class="fsz-12 mgb-2">Auto Save Results</label>
                        <div class="bg-primary hx-02 wx-04 corner-3 pd-1 flex @(autoSaveResults ? "flex-end" : "flex-start")"
                             role="switch" aria-checked="@autoSaveResults" style="cursor: pointer;"
                             @onclick="() => UpdateGeneralSettingAsync(nameof(autoSaveResults), !autoSaveResults)">
                            <div class="bg-card round hf wx-02"></div>
                        </div>
                    </div>

                    <div class="flex flex-spacebetween mgb-5">
                        <label for="Language" class="fsz-12 mgb-2">Confirm before deleting</label>
                        <div class="bg-primary hx-02 wx-04 corner-3 pd-1 flex @(confirmBeforeDeleting ? "flex-end" : "flex-start")"
                             role="switch" aria-checked="@confirmBeforeDeleting" style="cursor: pointer;"
                             @onclick="() => UpdateGeneralSettingAsync(nameof(confirmBeforeDeleting), !confirmBeforeDeleting)">
                            <div class="bg-card round hf wx-02"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* APPEARANCE TAB *@
        @* <div class="settings-tab-content" id="appearanceTab" style="display: @(isAppearance ? "block" : "none");">
            <div class="mgb-20">
                <h3 class="fsz-15 mgb-2 cl-primary">Appearance</h3>
                <p class="text-muted fsz-12">
                    Customize how Physics Simulation Studio looks and feels.
                </p>
            </div>

            <div class="mgb-10">
                <div class="flex flex-spacebetween">
                    <div>
                        <h4 class="mg-0 fsz-13 pdb-2">Theme</h4>
                        <p class="text-muted fsz-12 mg-0">
                            Choose your preferred application appearance.
                        </p>
                    </div>
                    <select class="pd corner-2 bd fsz-12" id="appearanceTheme">
                        <option value="system">System Default</option>
                        <option value="light">Light</option>
                        <option value="dark">Dark</option>
                    </select>
                </div>
            </div>

            <div class="mgb-10">
                <div class="flex flex-spacebetween">
                    <div>
                        <h4 class="mg-0 fsz-13 pdb-2">Animation Quality</h4>
                        <p class="text-muted fsz-12 mg-0">
                            Control the visual quality of simulation animations.
                        </p>
                    </div>
                    <select class="pd corner-2 bd fsz-12" id="animationQuality">
                        <option value="low">Low</option>
                        <option value="medium" selected>Medium</option>
                        <option value="high">High</option>
                    </select>
                </div>
            </div>

            <div class="mgb-10">
                <div class="flex flex-spacebetween">
                    <div>
                        <h4 class="mg-0 fsz-13 pdb-2">Reduced Motion</h4>
                        <p class="text-muted fsz-12 mg-0">
                            Reduce interface animations and motion effects.
                        </p>
                    </div>
                    <input type="checkbox" id="reducedMotion" />
                </div>
            </div>
        </div> *@

        @* LIMITS & CONSTANTS TAB *@
        <div class="settings-tab-content" id="limitsConstantsTab" style="display: @(isLimit ? "block" : "none");">
            <div class="mgb-10">
                <h3 class="fsz-15 mgb-2 cl-primary">Limits & Constants</h3>
                <p class="text-muted fsz-12">
                    Configure physical constants and default simulation limits.
                </p>
            </div>

            @if (isLoadingSimulationSettings)
            {
                <p class="fsz-12 op-6">Loading simulation settings...</p>
            }

            @if (!string.IsNullOrWhiteSpace(simulationSettingsError))
            {
                <p class="fsz-12 cl-fatal mgb-10" role="alert">
                    @simulationSettingsError
                </p>
            }

            @if (!string.IsNullOrWhiteSpace(simulationSettingsMessage))
            {
                <p class="fsz-12 cl-success mgb-10" role="status">
                    @simulationSettingsMessage
                </p>
            }

            <div class="settings-card mgb-10 pd bdl corner-2">
                <h4 class="mg-0 fsz-15">Physical Constants</h4>
                <p class="text-muted fsz-12">
                    Values used as defaults in physics simulations.
                </p>

                <div class="mgt-5">
                    <div>
                        <h5 for="defaultGravity" class="cl-13">Gravitational Acceleration (m/s²)</h5>
                        <p class="text-muted fsz-12">
                            Standard Earth gravity is approximately 9.81 m/s².
                        </p>
                    </div>
                    <input type="number" id="defaultGravity" class="pd corner-2 bd" @bind="gravity" min="0.01" max="100"
                           step="0.01" />
                </div>
            </div>

            <div class="settings-card mgb-15 pd bdl corner-2">
                <h4 class="mg-0 fsz-15">Simulation Limits</h4>

                <div class="mgt-5">
                    <h5 for="maximumSimulationTime" class="cl-13">Maximum Simulation Time (s)</h5>
                    <input type="number" id="maximumSimulationTime" class="pd corner-2 bd" @bind="maximumSimulationTime"
                           min="1" step="1" />
                </div>

                <div class="mgt-5">
                    <h5 for="maximumDataPoints" class="cl-13">Maximum Data Points</h5>
                    <input type="number" id="maximumDataPoints" class="pd corner-2 bd" @bind="maximumDataPoints"
                           min="100" step="100" />
                </div>

                <div class="mgt-5">
                    <h5 for="defaultTimeStep" class="cl-13">Default Time Step (s)</h5>
                    <input type="number" id="defaultTimeStep" class="pd corner-2 bd" @bind="defaultTimeStep" min="0.001"
                           step="0.001" />
                </div>
            </div>

            <div class="mgb-5">
                <p class="text-muted fsz-12 mg-0">
                    Changes to these values should affect new simulations only.
                    Previously saved simulation results should retain their recorded
                    parameters.
                </p>
            </div>

            <button class="pd bg-primary bd-none corner-2 text-right block" @onclick="SaveSimulationSettingsAsync"
                    disabled="@(isLoadingSimulationSettings || isSavingSimulationSettings)">
                @(isSavingSimulationSettings ? "Saving..." : "Save Setting")
            </button>
        </div>

        @* DEFAULT PARAMETERS TAB *@
        @* <div class="settings-tab-content" id="defaultParametersTab"
             style="display: @(isParameters ? "block" : "none");">
            <div class="mgb-10">
                <h3 class="fsz-15 mgb-2 cl-primary">Default Parameters</h3>
                <p class="text-muted fsz-12">
                    Set the initial values used when creating a new simulation.
                </p>
            </div>

            <div class="settings-card mgb-10 pd bdl corner-2">
                <h4 class="mg-0 fsz-15">Projectile Motion</h4>

                <div class="mgt-5">
                    <h5 for="maximumSimulationTime" class="cl-13">Initial Velocity (m/s)</h5>
                    <input type="number" id="maximumSimulationTime" class="pd corner-2 bd" value="30" min="0" />
                </div>

                <div class="mgt-5">
                    <h5 for="maximumDataPoints" class="cl-13">Launch Angle (degrees)</h5>
                    <input type="number" id="maximumDataPoints" class="pd corner-2 bd" value="45" min="0" max="90" />
                </div>

