        @* ABOUT TAB *@
        
        @* ABOUT TAB *@
        <div class="settings-tab-content" id="aboutTab" style="display: @(isAbout ? "block" : "none");">

            <div class="mgb-20">
                <h3 class="fsz-15 mgb-2 cl-primary">About Physics Simulation Studio</h3>
                <p class="text-muted fsz-12">
                    Learn about PSS, its purpose, capabilities, and vision for computational physics.
                </p>
            </div>

            @* PSS BRANDING *@
            <div class="settings-card mgb-10">
                <div class="text-center">
                    @* <h2 class="mg-0 fsz-24 cl-primary">PSS</h2> *@
                    <div class="wf flex flex-center">
                        <img src="pss.png" alt="" class="hx-1 wx-1 corner-2">
                    </div>
                    <p class="fsz-15 mg-0">Physics Simulation Studio</p>
                    <p class="text-muted fsz-13 mg-0 mgt-5">
                        Simulate. Visualize. Analyze. Understand.
                    </p>
                    <p class="text-muted fsz-12 mgt-10">
                        A computational environment for exploring physical systems
                        through numerical simulation and scientific analysis.
                    </p>
                </div>
            </div>

            @* ABOUT THE PLATFORM *@
            <div class="mgb-20">
                <h4 class="mg-0 fsz-15 pdb-3">What is PSS?</h4>
                <p class="text-muted fsz-13">
                    Physics Simulation Studio (PSS) is an interactive software platform
                    designed to help users model physical systems, run numerical
                    simulations, and examine the results through visual and numerical
                    analysis.
                </p>
                <p class="text-muted fsz-13">
                    PSS brings simulation parameters, calculated results, graphs,
                    data tables, simulation history, notes, and export tools into
                    one workspace. Its goal is to make computational physics easier
                    to explore, understand, and apply.
                </p>
            </div>

            @* CORE CAPABILITIES *@
            <div class="mgb-20">
                <h4 class="mg-0 fsz-15 pdb-3">Core Capabilities</h4>

                <div class="settings-card mgb-10">
                    <div class="flex" style="align-items: flex-start; gap: 10px;">
                        <i class="mdi mdi-calculator-variant fsz-20 cl-primary"></i>
                        <div>
                            <h5 class="mg-0 fsz-14">Numerical Simulation</h5>
                            <p class="text-muted fsz-12 mgt-5">
                                Configure simulation parameters and compute the
                                behaviour of supported physical models using
                                numerical methods.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="settings-card mgb-10">
                    <div class="flex" style="align-items: flex-start; gap: 10px;">
                        <i class="mdi mdi-chart-line fsz-20 cl-primary"></i>
                        <div>
                            <h5 class="mg-0 fsz-14">Visualization and Analysis</h5>
                            <p class="text-muted fsz-12 mgt-5">
                                Explore simulation results through interactive graphs,
                                numerical data tables, and calculated physical
                                quantities.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="settings-card mgb-10">
                    <div class="flex" style="align-items: flex-start; gap: 10px;">
                        <i class="mdi mdi-history fsz-20 cl-primary"></i>
                        <div>
                            <h5 class="mg-0 fsz-14">Simulation History and Notes</h5>
                            <p class="text-muted fsz-12 mgt-5">
                                Save and revisit simulation results, retain the
                                parameters used for previous runs, and document
                                observations with simulation notes.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="settings-card mgb-10">
                    <div class="flex" style="align-items: flex-start; gap: 10px;">
                        <i class="mdi mdi-file-export-outline fsz-20 cl-primary"></i>
                        <div>
                            <h5 class="mg-0 fsz-14">Data Export</h5>
                            <p class="text-muted fsz-12 mgt-5">
                                Export simulation data and results into supported
                                formats for further analysis, reporting, and record
                                keeping.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="settings-card mgb-10">
                    <div class="flex" style="align-items: flex-start; gap: 10px;">
                        <i class="mdi mdi-tune-variant fsz-20 cl-primary"></i>
                        <div>
                            <h5 class="mg-0 fsz-14">Configurable Simulation Settings</h5>
                            <p class="text-muted fsz-12 mgt-5">
                                Configure global physical constants, simulation
                                duration limits, data-point limits, and default
                                time-step settings where supported.
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            @* INTENDED USERS *@
            <div class="mgb-20">
                <h4 class="mg-0 fsz-15 pdb-3">Who is PSS for?</h4>
                <p class="text-muted fsz-13">
                    PSS is intended for students learning physics, educators
                    demonstrating physical concepts, researchers exploring numerical
                    models, and developers building an understanding of computational
                    methods.
                </p>
            </div>

            @* PROJECT VISION *@
            <div class="mgb-20">
                <h4 class="mg-0 fsz-15 pdb-3">Vision and Direction</h4>
                <p class="text-muted fsz-13">
                    PSS is being developed as a modular environment for computational
                    physics. Its long-term direction is to expand the range of
                    supported physical models, numerical methods, visualization
                    capabilities, and scientific analysis tools within one integrated
                    platform.
                </p>
                <p class="text-muted fsz-13">
                    The aim is not simply to calculate answers, but to help users
                    investigate how physical systems behave, understand the results,
                    and communicate their findings.
                </p>
            </div>

            @* APPLICATION INFORMATION *@
            <div class="mgb-20">
                <h4 class="mg-0 fsz-15 pdb-3">Application Information</h4>

                <div class="flex flex-spacebetween mgt-5">
                    <span class="text-muted fsz-13">Application</span>
                    <span class="fsz-12">Physics Simulation Studio</span>
                </div>

                <div class="flex flex-spacebetween mgt-5">
                    <span class="text-muted fsz-13">Abbreviation</span>
                    <span class="fsz-12">PSS</span>
                </div>

                <div class="flex flex-spacebetween mgt-5">
                    <span class="text-muted fsz-13">Version</span>
                    <span class="fsz-12">1.0.0</span>
                </div>

                <div class="flex flex-spacebetween mgt-5">
                    <span class="text-muted fsz-13">Platform</span>
                    <span class="fsz-12">Web Application</span>
                </div>
            </div>

            @* FOOTER *@
            <div class="settings-card">
                <div class="text-center">
                    <p class="fsz-13 mg-0">
                        Physics Simulation Studio
                    </p>
                    <p class="text-muted fsz-12 mgt-5">
                        An evolving platform for computational physics
                        and scientific exploration.
                    </p>
                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private bool isSetting = false;
    private bool isGeneral = true;
    private bool isAppearance = false;
    private bool isLimit = false;
    private bool isParameters = false;
    private bool isStorage = false;
    private bool isAbout = false;

    private bool showTipsOnStartup = true;
    private bool autoSaveResults = true;
    private bool confirmBeforeDeleting = true;

    private bool isLoadingGeneralSettings = false;
    private bool isSavingGeneralSettings = false;
    private string? generalSettingsError;
    private string? generalSettingsMessage;

    private double gravity = 9.81;
    private double maximumSimulationTime = 100;
    private int maximumDataPoints = 10000;
    private double defaultTimeStep = 0.05;

    private bool isLoadingSimulationSettings;
    private bool isSavingSimulationSettings;
    private string? simulationSettingsError;
    private string? simulationSettingsMessage;

    private void IsSetting()
    {
        isSetting = !isSetting;
    }

    private void IsGeneral()
    {
        isGeneral = true;
        isAppearance = false;
        isLimit = false;
        isParameters = false;
        isStorage = false;
        isAbout = false;
    }

    private void IsAppearance()
    {
        isGeneral = false;
        isAppearance = true;
        isLimit = false;
        isParameters = false;
        isStorage = false;
        isAbout = false;
    }

    private void IsLimit()
    {
        isGeneral = false;
        isAppearance = false;
        isLimit = true;
        isParameters = false;
        isStorage = false;
        isAbout = false;
    }

    private void IsParameters()
    {
        isGeneral = false;
        isAppearance = false;
        isLimit = false;
        isParameters = true;
        isStorage = false;
        isAbout = false;
    }

    private void IsStorage()
    {
        isGeneral = false;
        isAppearance = false;
        isLimit = false;
        isParameters = false;
        isStorage = true;
        isAbout = false;
    }

    private void IsAbout()
    {
        isGeneral = false;
        isAppearance = false;
        isLimit = false;
        isParameters = false;
        isStorage = false;
        isAbout = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadGeneralSettingsAsync();
        await LoadSimulationSettingsAsync();
    }

    private async Task LoadGeneralSettingsAsync()
    {
        isLoadingGeneralSettings = true;
        generalSettingsError = null;

        try
        {
            var settings = await Http.GetFromJsonAsync<GeneralSettingsResponse>(
                "/api/settings/general/");

            if (settings is null)
            {
                generalSettingsError = "The backend returned no general settings.";
                return;
            }

            showTipsOnStartup = settings.ShowTipsOnStartup;
            autoSaveResults = settings.AutoSaveResults;
            confirmBeforeDeleting = settings.ConfirmBeforeDeleting;
        }
        catch (HttpRequestException)
        {
            generalSettingsError =
                "Could not connect to the PSS backend. Check that the API is running on port 5004.";
        }
        catch (System.Text.Json.JsonException)
        {
            generalSettingsError =
                "Could not read the general settings returned by the backend.";
        }
        finally
        {
            isLoadingGeneralSettings = false;
        }
    }

    private async Task LoadSimulationSettingsAsync()
    {
        isLoadingSimulationSettings = true;
        simulationSettingsError = null;

        try
        {
            var settings =
                await Http.GetFromJsonAsync<SimulationSettingsResponse>(
                    "/api/settings/simulation/");

            if (settings is null)
            {
                simulationSettingsError =
                    "The backend returned no simulation settings.";
                return;
            }

            gravity = settings.Gravity;
            maximumSimulationTime = settings.MaximumSimulationTime;
            maximumDataPoints = settings.MaximumDataPoints;
            defaultTimeStep = settings.DefaultTimeStep;
        }
        catch (HttpRequestException)
        {
            simulationSettingsError =
                "Could not load simulation settings. Check that the PSS backend is running.";
        }
        catch (System.Text.Json.JsonException)
        {
            simulationSettingsError =
                "Could not read the simulation settings returned by the backend.";
        }
        finally
        {
            isLoadingSimulationSettings = false;
        }
    }

    private async Task UpdateGeneralSettingAsync(
    string settingName,
    bool newValue)
    {
        if (isLoadingGeneralSettings || isSavingGeneralSettings)
            return;

        var previousShowTips = showTipsOnStartup;
        var previousAutoSave = autoSaveResults;
        var previousConfirmDelete = confirmBeforeDeleting;

        switch (settingName)
        {
            case nameof(showTipsOnStartup):
                showTipsOnStartup = newValue;
                break;

            case nameof(autoSaveResults):
                autoSaveResults = newValue;
                break;

            case nameof(confirmBeforeDeleting):
                confirmBeforeDeleting = newValue;
                break;

            default:
                return;
        }

        isSavingGeneralSettings = true;
        generalSettingsError = null;
        generalSettingsMessage = null;

        try
        {
            var request = new
            {
                ShowTipsOnStartup = showTipsOnStartup,
                AutoSaveResults = autoSaveResults,
                ConfirmBeforeDeleting = confirmBeforeDeleting
            };

            using var response = await Http.PutAsJsonAsync(
                "/api/settings/general/",
                request);

            if (response.IsSuccessStatusCode)
            {
                generalSettingsMessage = "General settings saved successfully.";
            }
            else
            {
                showTipsOnStartup = previousShowTips;
                autoSaveResults = previousAutoSave;
                confirmBeforeDeleting = previousConfirmDelete;

                generalSettingsError =
                    $"Could not save settings. Server returned {(int)response.StatusCode}.";
            }
        }
        catch (HttpRequestException)
        {
            showTipsOnStartup = previousShowTips;
            autoSaveResults = previousAutoSave;
            confirmBeforeDeleting = previousConfirmDelete;

            generalSettingsError =
                "Could not connect to the PSS backend. Your previous settings have been restored.";
        }
        finally
        {
            isSavingGeneralSettings = false;
        }
    }

    private async Task SaveSimulationSettingsAsync()
    {
        if (isLoadingSimulationSettings || isSavingSimulationSettings)
            return;

        simulationSettingsError = null;
        simulationSettingsMessage = null;

        if (!double.IsFinite(gravity) ||
            gravity < 0.01 || gravity > 100)
        {
            simulationSettingsError =
                "Gravity must be between 0.01 and 100.";
            return;
        }

        if (!double.IsFinite(maximumSimulationTime) ||
            maximumSimulationTime < 1)
        {
            simulationSettingsError =
                "Maximum simulation time must be at least 1 second.";
            return;
        }

        if (maximumDataPoints < 100)
        {
            simulationSettingsError =
                "Maximum data points must be at least 100.";
            return;
        }

        if (!double.IsFinite(defaultTimeStep) ||
            defaultTimeStep < 0.001)
        {
            simulationSettingsError =
                "Default time step must be at least 0.001 seconds.";
            return;
        }

        isSavingSimulationSettings = true;

        try
        {
            var request = new
            {
                Gravity = gravity,
                MaximumSimulationTime = maximumSimulationTime,
                MaximumDataPoints = maximumDataPoints,
                DefaultTimeStep = defaultTimeStep
            };

            using var response = await Http.PutAsJsonAsync(
                "/api/settings/simulation/",
                request);

            if (response.IsSuccessStatusCode)
            {
                simulationSettingsMessage =
                    "Simulation settings saved successfully.";
            }
            else
            {
                simulationSettingsError =
                    $"Could not save simulation settings. Server returned {(int)response.StatusCode}.";
            }
        }
        catch (HttpRequestException)
        {
            simulationSettingsError =
                "Could not connect to the PSS backend. Your changes were not saved.";
        }
        finally
        {
            isSavingSimulationSettings = false;
        }
    }
}