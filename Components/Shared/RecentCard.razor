
<div class="flex flex-spacebetween flex-center pd bdl corner-2">
    <div class="corner-3 flex flex-center">

        @if (!string.IsNullOrWhiteSpace(Image))
        {
            <img src="@Image"
                 alt="@Title"
                 class="wx-05 hx-05 fsz-15" />
        }

        <div class="text-center wf hx-05 pd">
            <h3 class="mg-0 pdt fsz-15 text-left">@Title</h3>
            <p class="mg-0 fsz-12 op-7 text-left">@SubTitle</p>
        </div>
    </div>

    <i class="mdi mdi-arrow-right fsz-20 setting-btn"></i>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string SubTitle { get; set; } = "";
    [Parameter] public string Image { get; set; } = "";
}
