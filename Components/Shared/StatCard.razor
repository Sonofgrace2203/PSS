
<div class="pd bd corner-3">
    <div class="flex flex-center">
        @if (!string.IsNullOrWhiteSpace(Image))
        {
            <img src="@Image"
                 alt="@Title"
                 class="wx-1 hx-1 fsz-15">
        }
    </div>

    <div class="text-center wf hx-05 pd">
        <h3 class="mg-0 pdb fsz-15 text-left">@Title</h3>
        <p class="mg-0 fsz-12 op-7 text-left">@SubTitle</p>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string SubTitle { get; set; } = "";
    [Parameter] public string Image { get; set; } = "";
}
