@if (TotalItems > 0)
{
    <div class="flex flex-spacebetween flex-center flow mgt-15 mgb-10">
        <div class="flex flex-center flow">
            <span class="fsz-12 op-6">
                Showing @StartItem–@EndItem of @TotalItems @(TotalItems == 1 ? ItemLabel : ItemLabel + "s")
            </span>

            <select class="pd corner-2 bd fsz-12" value="@PageSize" disabled="@IsPageSizeChangeDisabled"
                    @onchange="ChangePageSize">
                <option value="5">5 per page</option>
                <option value="10">10 per page</option>
                <option value="20">20 per page</option>
                <option value="50">50 per page</option>
            </select>
        </div>

        <div class="flex flex-center flow">
            <button type="button" class="bd corner-2 pd fsz-12 mgr-1" disabled="@(CurrentPage <= 1)" @onclick="PreviousPage">
                Previous
            </button>

            @foreach (var page in VisiblePages)
            {
                if (page == 0)
                {
                    <span class="pd fsz-12">…</span>
                }
                else
                {
                    <button type="button" @key="page"
                            class="bd corner-2 pd fsz-12 mgr-1 @(page == CurrentPage ? "bg-primary-01 cl-primary" : "")"
                            aria-current="@(page == CurrentPage ? "page" : null)" aria-label="@($"Go to page {page}")"
                            disabled="@(page == CurrentPage)" @onclick="() => GoToPage(page)">
                        @(page)
                    </button>
                }
            }

            <button type="button" class="bd corner-2 pd fsz-12 mgr-1" disabled="@(CurrentPage >= TotalPages)" @onclick="NextPage">
                Next
            </button>
        </div>
    </div>
}

@code {
    [Parameter]
    public int CurrentPage { get; set; } = 1;

    [Parameter]
    public int TotalPages { get; set; } = 1;

    [Parameter]
    public int TotalItems { get; set; }

    [Parameter]
    public int PageSize { get; set; } = 10;

    [Parameter]
    public string ItemLabel { get; set; } = "item";

    [Parameter]
    public EventCallback<int> CurrentPageChanged { get; set; }

    [Parameter]
    public EventCallback<int> PageSizeChanged { get; set; }

    [Parameter]
    public bool IsPageSizeChangeDisabled { get; set; }

    private int StartItem =>
        TotalItems == 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;

    private int EndItem =>
        Math.Min(CurrentPage * PageSize, TotalItems);

    private List<int> VisiblePages
    {
        get
        {
            var pages = new List<int>();

            if (TotalPages <= 5)
            {
                for (int page = 1; page <= TotalPages; page++)
                {
                    pages.Add(page);
                }

                return pages;
            }

            // Always show the first page.
            pages.Add(1);

            if (CurrentPage > 3)
            {
                pages.Add(0); // Ellipsis
            }

            // Show nearby pages when navigating through the middle.
            int start = Math.Max(2, CurrentPage - 1);
            int end = Math.Min(TotalPages - 1, CurrentPage + 1);

            for (int page = start; page <= end; page++)
            {
                pages.Add(page);
            }

            if (CurrentPage < TotalPages - 2)
            {
                pages.Add(0); // Ellipsis
            }

            // Always show the last page.
            pages.Add(TotalPages);

            return pages;
        }
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage)
            return;

        await CurrentPageChanged.InvokeAsync(page);
    }

    private async Task PreviousPage()
    {
        await GoToPage(CurrentPage - 1);
    }

    private async Task NextPage()
    {
        await GoToPage(CurrentPage + 1);
    }

    private async Task ChangePageSize(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out int newPageSize))
            return;

        if (newPageSize <= 0 || newPageSize == PageSize)
            return;

        await PageSizeChanged.InvokeAsync(newPageSize);
    }
}
