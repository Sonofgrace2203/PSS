<div class="pd corner-2 bd" style="position: relative;
    cursor: @(IsImplemented ? "pointer" : "not-allowed");
    opacity: @(IsImplemented ? "1" : "0.55");" @onclick="HandleOnclick">

    <div class="flex flex-spacebetween flex-center">
        <div class="corner-3 flex flex-center">
            <img src="@ImageUrl" alt="" class="wx-05 hx-05 fsz-15" loading="lazy" onerror="this.style.display='none'" />

            <div class="text-center wf hx-05 pd">
                <h3 class="mg-0 pdt fsz-13 text-left">@Title</h3>
                <p class="mg-0 fsz-12 op-7 text-left">@SubTitle</p>

                
            </div>
        </div>
    </div>

    <button type="button" class="bd flex flex-center" style="position:absolute; top:5px; right:5px;
        background:transparent; border:0; cursor:pointer;"
            title="@(IsFavourite ? "Remove from favourites" : "Add to favourites")"
            aria-label="@(IsFavourite ? "Remove from favourites" : "Add to favourites")" aria-pressed="@IsFavourite"
            @onclick="HandleFavoriteClick" @onclick:stopPropagation="true">
        @if (!IsImplemented)
        {
            <p class="mg-0 fsz-10 pdr-3 fw-bold cl-fatal corner-02 text-right">
                Coming soon
            </p>
        }
        <i class="mdi @(IsFavourite ? "mdi-star" : "mdi-star-outline") fsz-15"></i>
    </button>
</div>

@code {
    [Parameter] public Guid ModuleId { get; set; }
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string SubTitle { get; set; } = "";
    [Parameter] public bool IsImplemented { get; set; }
    [Parameter] public bool IsFavourite { get; set; }
    [Parameter] public string ImageUrl { get; set; } = "";

    [Parameter] public EventCallback OnClick { get; set; }
    [Parameter] public EventCallback OnFavoriteClick { get; set; }

    private async Task HandleOnclick()
    {
        if (!IsImplemented)
            return;

        await OnClick.InvokeAsync();
    }

    private async Task HandleFavoriteClick()
    {
        await OnFavoriteClick.InvokeAsync();
    }
}
